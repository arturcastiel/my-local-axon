@@ -0,0 +1,67 @@
+"""axon-bugfree10 PR-09 — workflow_run.py
+
+B082: promoted `*.draft.yml` files must NOT be enumerated as installed workflows
+      (drafts are "never auto-activated" and would otherwise shadow the active .yml).
+B083: an unquoted YAML boolean `if: true` must be an always-taken rule, not dropped.
+"""
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "tools"))
+import workflow_run as wr  # noqa: E402
+
+
+# ── B083: boolean-true if is always taken ────────────────────────────────────
+
+def _wf_bool_true():
+    return {"synapses": [
+        {"id": "s1", "on-complete": [
+            {"if": True, "next": "X"},
+            {"next": "Y"}]},
+        {"id": "X", "on-complete": []},
+        {"id": "Y", "on-complete": []}]}
+
+
+def test_boolean_true_if_is_taken():
+    # `if: true` (YAML boolean → Python True) must fire, not fall through to Y.
+    r = wr.resolve_next(_wf_bool_true(), "s1", {})
+    assert r["next"] == "X", r
+
+
+def test_boolean_false_if_still_skipped():
+    # regression guard: a real falsy predicate is still never taken.
+    wf = {"synapses": [
+        {"id": "s1", "on-complete": [
+            {"if": False, "next": "X"},
+            {"next": "Y"}]},
+        {"id": "X", "on-complete": []},
+        {"id": "Y", "on-complete": []}]}
+    assert wr.resolve_next(wf, "s1", {})["next"] == "Y"
+
+
+# ── B082: draft files are excluded from enumeration ──────────────────────────
+
+def test_draft_yml_excluded_from_list_workflows(tmp_path):
+    wsdir = tmp_path / "workspace" / "workflows"
+    wsdir.mkdir(parents=True)
+    (wsdir / "foo.yml").write_text("name: foo\nversion: 9\nsynapses: []\n", encoding="utf-8")
+    (wsdir / "foo.draft.yml").write_text("name: foo\nversion: 1\nsynapses: []\n", encoding="utf-8")
+
+    rows = wr.list_workflows(str(tmp_path / "workspace"))
+    paths = [r["path"] for r in rows]
+    assert any(p.endswith("foo.yml") and not p.endswith("foo.draft.yml") for p in paths)
+    assert not any(p.endswith(".draft.yml") for p in paths), paths
+
+
+def test_draft_does_not_shadow_active_in_names(tmp_path):
+    wsdir = tmp_path / "workspace" / "workflows"
+    wsdir.mkdir(parents=True)
+    (wsdir / "foo.yml").write_text("name: foo\nversion: 9\nsynapses: []\n", encoding="utf-8")
+    (wsdir / "foo.draft.yml").write_text("name: foo\nversion: 1\nsynapses: []\n", encoding="utf-8")
+
+    rows = wr.list_workflows(str(tmp_path / "workspace"))
+    foo_rows = [r for r in rows if r.get("name") == "foo"]
+    # exactly one 'foo' — the active one, at version 9 (the draft is gone)
+    assert len(foo_rows) == 1, foo_rows
+    assert foo_rows[0]["version"] == 9
