 _EXEC_RE = re.compile(r'EXEC\(')
 
+# Doc-only markdown sections whose bodies are human documentation, not
+# executable AXON-LANG. EXEC/STORE tokens appearing here are examples.
+_DOC_SECTIONS = {
+    "HELP", "PURPOSE", "OVERVIEW", "RATIONALE", "NOTES",
+    "EXAMPLES", "EXAMPLE", "DESCRIPTION", "WHY", "WHEN",
+    "AUTHORING-NOTES",
+}
+_SECTION_RE = re.compile(r'^##\s*([A-Z][A-Z\-/ ]*)', re.MULTILINE)
+
+
+def _doc_section_ranges(text: str) -> list:
+    """Return [start, end) ranges that belong to doc-only sections."""
+    ranges = []
+    headers = list(_SECTION_RE.finditer(text))
+    for i, m in enumerate(headers):
+        name = m.group(1).strip().rstrip(":").upper().replace(" ", "-")
+        if name not in _DOC_SECTIONS:
+            continue
+        start = m.start()
+        end = headers[i + 1].start() if i + 1 < len(headers) else len(text)
+        ranges.append((start, end))
+    return ranges
+
+
+def _in_exempt_range(pos: int, ranges: list) -> bool:
+    return any(lo <= pos < hi for lo, hi in ranges)
+
+
+def _in_quoted_string(text: str, pos: int) -> bool:
+    """True if pos is inside a single/double-quoted string on its line."""
+    line_start = text.rfind("\n", 0, pos) + 1
+    line_so_far = text[line_start:pos]
+    in_single = in_double = False
+    i = 0
+    while i < len(line_so_far):
+        c = line_so_far[i]
+        if c == "\\" and i + 1 < len(line_so_far):
+            i += 2
+            continue
+        if c == "'" and not in_double:
+            in_single = not in_single
+        elif c == '"' and not in_single:
+            in_double = not in_double
+        i += 1
+    return in_single or in_double
+
+
+def _in_comment(text: str, pos: int) -> bool:
+    line_start = text.rfind("\n", 0, pos) + 1
+    line = text[line_start:pos]
+    return line.lstrip().startswith("#")
+
+
+def _first_real_match(regex, text: str, exempt_ranges: list):
+    """First regex match whose start is not in a comment, quoted string,
+    or doc-only section — i.e. a real AXON-LANG op, not documentation."""
+    for m in regex.finditer(text):
+        pos = m.start()
+        if _in_exempt_range(pos, exempt_ranges):
+            continue
+        if _in_quoted_string(text, pos):
+            continue
+        if _in_comment(text, pos):
+            continue
+        return m
+    return None
+
 
