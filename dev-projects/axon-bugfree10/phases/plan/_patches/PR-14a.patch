-            if line.startswith("|") and "---" not in line and "Date" not in line:
-                cols = [c.strip() for c in line.split("|")[1:-1]]
-                if cols and cols[0] not in ("—", ""):
-                    rows.append(cols)
+            if not line.startswith("|"):
+                continue
+            cols = [c.strip() for c in line.split("|")[1:-1]]
+            if not cols:
+                continue
+            first = cols[0]
+            # Identify header/separator rows structurally by their FIRST cell,
+            # not by substring-scanning the whole line — otherwise a data row
+            # whose workflow (or other column) contains "Date" or "---" would
+            # be silently dropped.
+            if first == "Date":                       # header row
+                continue
+            if first and set(first) <= {"-"}:         # separator row (all dashes)
+                continue
+            if first in ("—", ""):                    # empty/placeholder row
+                continue
+            rows.append(cols)
     return rows
 
