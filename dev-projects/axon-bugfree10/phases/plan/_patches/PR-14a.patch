diff --git a/tests/test_tokenizer.py b/tests/test_tokenizer.py
new file mode 100644
index 0000000..3bddb7e
--- /dev/null
+++ b/tests/test_tokenizer.py
@@ -0,0 +1,23 @@
+"""Tests for tools/tokenizer.py — exact token counting for text/files."""
+from conftest import run  # noqa: E402
+
+
+def test_text_counts_tokens():
+    out, rc = run(["tools/tokenizer.py", "--text", "hello world"])
+    assert rc == 0
+    assert out["source"] == "inline"
+    assert out["tokens"] >= 1
+
+
+# ── B091: empty --text must be counted, not fall through to the file branch ──
+
+def test_empty_text_returns_zero_tokens():
+    """`--text ""` satisfies the mutually-exclusive group, so args.files is None.
+    A falsy-check (`if args.text:`) would fall into the file branch and crash on
+    `for path in args.files` with TypeError. Empty text must yield 0 tokens
+    (regression: B091)."""
+    out, rc = run(["tools/tokenizer.py", "--text", ""])
+    assert rc == 0, f"empty --text should not crash; got rc={rc}, out={out!r}"
+    assert out["source"] == "inline"
+    assert out["tokens"] == 0
+    assert out["chars"] == 0
