+# ── B086: a legitimately-supplied 0 must NOT be treated as "missing" ──────────
+
+def test_main_record_accepts_zero_cmp_tokens(tmp_path):
+    """--cmp-tokens 0 (a compilation that emitted zero tokens) is a valid value;
+    the required-args guard must not reject it as missing (regression: B086)."""
+    ws = str(tmp_path)
+    out, rc = run(["tools/benchmark.py", "record", "--workflow", "wf",
+                   "--src-tokens", "100", "--cmp-tokens", "0", "--workspace", ws])
+    assert rc == 0 and out.get("recorded") is True and out["ratio"] == 100.0
+    out, _ = run(["tools/benchmark.py", "list", "--workspace", ws])
+    assert out["count"] == 1
+
+
+# ── B087: rows whose columns contain 'Date' or '---' must not be dropped ──────
+
+def test_load_log_keeps_workflow_named_like_header(tmp_path):
+    """A data row whose workflow contains the substrings 'Date' or '---' must
+    still be parsed — header/separator detection is structural, not substring
+    scanning of the whole line (regression: B087)."""
+    log = tmp_path / "b.md"
+    log.write_text("# BENCHMARK LOG\n\n" + bm.HEADER +
+                   "| 2026-01-01 | Date-parser | 1000 | 400 | 60.0% | 0 | m | $0.001 |\n"
+                   "| 2026-01-02 | a---b | 2000 | 500 | 75.0% | 0 | m | $0.001 |\n")
+    rows = bm.load_log(str(log))
+    workflows = [r[1] for r in rows]
+    assert workflows == ["Date-parser", "a---b"]
