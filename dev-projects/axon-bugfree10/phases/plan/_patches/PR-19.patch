+"""Content pins for axon-bugfree10 PR-19 — code-dev arg/tool/result marshaling.
+
+These programs are LLM-interpreted, so the mechanical surface (the source text)
+is the contract. Each pin cites the bug it guards: the dead/buggy marshaling must
+stay dead, and the repaired marshaling must stay present.
+"""
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+PROG = ROOT / "workspace" / "programs"
+
+
+def _read(name: str) -> str:
+    """Program source with comment lines stripped — pins govern executable ops;
+    explanatory comments may name the dead patterns they replaced."""
+    lines = (PROG / name).read_text(encoding="utf-8").splitlines()
+    return "\n".join(l for l in lines if not l.lstrip().startswith("#"))
+
+
+# ── B035: changelog reads 02-prs.md as a bullet list, not a table ─────────────
+
+def test_changelog_does_not_table_extract_02prs():
+    src = _read("code-dev-changelog.md")
+    # dead: 02-prs.md is a bullet list; table-rows extraction + col5 filter always empty
+    assert "table-rows=true" not in src
+    assert 'col5="merged"' not in src
+    assert "p.col0" not in src and "p.col1" not in src
+
+
+def test_changelog_parses_status_line_for_merged():
+    src = _read("code-dev-changelog.md")
+    assert "Status:" in src               # the real status carrier in 02-prs.md
+    assert 'CONTAINS "merged"' in src     # filter on status text
+    assert "p.id" in src and "p.title" in src
+
+
+# ── B037: shadow SCAN appends to the tool-returned shadow_path ────────────────
+
+def test_shadow_scan_uses_returned_shadow_path_for_appends():
+    src = _read("code-dev-knowledge-shadow.md")
+    # dead: rel-path-based append target never exists (init used the abs-path convention)
+    assert "{shadow-dir}/{rel-path}.findings.md" not in src
+    assert "sh ← TOOL(shadow, init" in src
+    assert src.count("--shadow-path {sh.shadow_path}") == 4
+
+
+# ── B038: meta igap passes an integer to --days ───────────────────────────────
+
+def test_meta_igap_strips_day_suffix_before_days_flag():
+    src = _read("code-dev-meta-igap.md")
+    assert "--days {since}" not in src          # dead: "7d" is not an int
+    assert "--days {since-days}" in src
+    assert "since-days ←" in src
+
+
+# ── B041: shadow append has no --date flag ────────────────────────────────────
+
+def test_pr_review_shadow_append_has_no_date_flag():
+    src = _read("code-dev-pr-review.md")
+    assert "--date {ts.date}" not in src        # dead: argparse exit 2, write dropped
+
+
+# ── B043: state-resume unwraps the shell envelope .stdout ─────────────────────
+
+def test_state_resume_unwraps_git_branch_stdout():
+    src = _read("code-dev-state-resume.md")
+    # dead: binding the whole envelope to git-branch (no .stdout unwrap)
+    assert 'git-branch   ← IF codebase ≠ ∅ →' not in src
+    assert "git-branch-r ←" in src
+    assert "git-branch-r.stdout" in src
