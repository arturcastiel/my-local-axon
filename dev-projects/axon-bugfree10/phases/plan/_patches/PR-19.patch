diff --git a/workspace/programs/code-dev-state-resume.md b/workspace/programs/code-dev-state-resume.md
index 1621fca..75558e8 100644
--- a/workspace/programs/code-dev-state-resume.md
+++ b/workspace/programs/code-dev-state-resume.md
@@ -131,9 +131,15 @@ shadow-stats ← TOOL(shadow, stats, "--shadow-dir {shadow-dir}") | ∅
 
 ## ─── BRANCH STATE ──────────────────────────────────────────────────────
 codebase     ← proj-meta.codebase | ∅
-git-branch   ← IF codebase ≠ ∅ →
-                 TOOL(shell, "git -C {codebase} branch --show-current 2>/dev/null") | "not-a-repo"
-               | "—"
+# TOOL(shell) returns an envelope {ok,verdict,stdout,…} — bind it, then unwrap .stdout
+# (sibling codemap-new.md does the same). Binding the whole envelope would make every
+# comparison below false and interpolate the raw dict into the resume marker.
+git-branch-r ← IF codebase ≠ ∅ →
+                 TOOL(shell, "git -C {codebase} branch --show-current 2>/dev/null") | ∅
+               | ∅
+git-branch   ← IF codebase ≡ ∅ → "—"
+             | TRIM(git-branch-r.stdout) ≠ "" → TRIM(git-branch-r.stdout)
+             | "not-a-repo"
 branch-state ← IF git-branch ≡ meta-branch → "✓"
               | IF git-branch ≡ "not-a-repo" OR git-branch ≡ "—" → "?"
               | "⚠ drift"
