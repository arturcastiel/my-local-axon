@@ -38,8 +38,20 @@ profile ← READ("{proj-dir}/_profile.md") | ∅
 phase ← meta.phase
 phase-dir ← "{proj-dir}/phases/{phase}"
 
-prs ← EXTRACT(READ("{phase-dir}/02-prs.md"), table-rows=true, skip-header=true)
-merged-prs ← FILTER(prs, col5="merged")
+# 02-prs.md is authored by code-dev-plan.md as a bullet list (NOT a markdown table):
+# each PR is a '## {id} — {title}' section with a '- **Status:** ...' line updated in place.
+# Table-row extraction returns nothing here, so parse the sections and keep those whose
+# Status line indicates merged.
+prs-content ← READ("{phase-dir}/02-prs.md")
+pr-blocks ← EXTRACT(prs-content, split="\n## ", mode=sections)
+merged-prs ← []
+∀ block in pr-blocks →
+  header ← FIRST-LINE(block)
+  id     ← EXTRACT(header, pattern="PR-\\d+") | ∅
+  title  ← EXTRACT(header, pattern="—\\s*(.+?)\\s*$", group=1) | id
+  status ← EXTRACT(block, pattern="- \\*\\*Status:\\*\\* (.+)", group=1) | ""
+  IF id ≠ ∅ AND status CONTAINS "merged" →
+    merged-prs ← merged-prs + [{id: id, title: title}]
 
 ts ← TOOL(clock)
 draft ← "## {phase} — {ts.date}\n\n"
@@ -47,10 +59,10 @@ IF COUNT(merged-prs) ≡ 0 →
   draft ← draft + "_(no merged PRs in this phase yet)_\n"
 ELSE →
   ∀ p in merged-prs →
-    spec-path ← IF FILE-EXISTS("{phase-dir}/03-prs/{p.col0}.md") → "{phase-dir}/03-prs/{p.col0}.md" | "{proj-dir}/03-prs/{p.col0}.md"
+    spec-path ← IF FILE-EXISTS("{phase-dir}/03-prs/{p.id}.md") → "{phase-dir}/03-prs/{p.id}.md" | "{proj-dir}/03-prs/{p.id}.md"
     spec ← READ(spec-path) | ""
-    sum  ← EXTRACT(spec, section="## Summary", first-paragraph=true) | p.col1
-    draft ← draft + "- **{p.col0}** {p.col1}\n  {sum}\n\n"
+    sum  ← EXTRACT(spec, section="## Summary", first-paragraph=true) | p.title
+    draft ← draft + "- **{p.id}** {p.title}\n  {sum}\n\n"
 
 # Show draft + ask
 → "▶ AXON / code-dev changelog  ·  [{phase}]"
