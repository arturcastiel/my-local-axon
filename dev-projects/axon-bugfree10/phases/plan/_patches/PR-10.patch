+# ---------- 11. B029: registry script field resolves name != filename ----------
+
+def test_registry_script_field_resolves_subcommands(fake_tools):
+    """A tool whose registry name differs from its script filename
+    (todo -> agent_todo.py) must still get its subcommands checked via the
+    REGISTRY 'script' field. Previously _subcommands_of('todo') opened the
+    nonexistent tools/todo.py, returned empty, and the rule skipped validation —
+    so a typo like TOOL(todo, lst) sailed through the BLOCK gate."""
+    fake_tools("agent_todo", """
+        import argparse
+        p = argparse.ArgumentParser()
+        sub = p.add_subparsers()
+        sub.add_parser("add")
+        sub.add_parser("list")
+        sub.add_parser("done")
+        sub.add_parser("due")
+    """)
+    registry = {"tools": {"todo": {"script": "tools/agent_todo.py", "status": "ACTIVE"}}}
+
+    # Valid subcommand passes.
+    assert r_tool_call_exists.check(_ctx("x ← TOOL(todo, list)", registry=registry)) is None
+
+    # Typo is now BLOCKED (was silently skipped before the fix).
+    r_tool_call_exists.clear_cache()
+    v = r_tool_call_exists.check(_ctx("x ← TOOL(todo, lst)", registry=registry))
+    assert v is not None
+    assert v.rule_id == "R_TOOL_CALL_EXISTS"
+    assert v.severity == "BLOCK"
+    # Hint should point at the real subcommand.
+    assert "list" in v.reason
+
+
+def test_no_registry_falls_back_to_name_based_path(fake_tools):
+    """Absent a registry entry, resolution falls back to tools/<name>.py so
+    tools whose name==filename keep working (backward-compatible)."""
+    fake_tools("dispatch_stats", """
+        import argparse
+        p = argparse.ArgumentParser()
+        sub = p.add_subparsers()
+        sub.add_parser("precision")
+    """)
+    assert r_tool_call_exists.check(_ctx("x ← TOOL(dispatch-stats, precision)")) is None
+    v = r_tool_call_exists.check(_ctx("x ← TOOL(dispatch-stats, bogus)"))
+    assert v is not None and v.rule_id == "R_TOOL_CALL_EXISTS"
