+def test_declared_subs_ignores_option_choices_when_no_subparsers():
+    """B089: a subparser-LESS tool whose only {...} group is an option's choices
+    (`--format {json,text}`) must return None — those choices are NOT subcommands.
+    The last-brace heuristic mistook them for a subcommand set, so a valid scoped
+    call-site TOOL(foo, "somearg") was flagged unknown-subcommand and BLOCKED."""
+    usage = "usage: foo [-h] [--format {json,text}] path\n"
+    assert ptc.declared_subs(usage) is None
+
+
+def test_declared_subs_skips_option_choices_but_keeps_real_subcommands():
+    """When BOTH an option-choices group and a positional subcommand group exist,
+    only the positional group is the action set."""
+    usage = "usage: tool [-h] [--format {json,text}] {add,list} ...\n"
+    assert ptc.declared_subs(usage) == {"add", "list"}
+
+
+def test_run_check_does_not_flag_choices_only_tool(monkeypatch):
+    """End-to-end B089: a call-site to a subparser-less, choices-only tool with a
+    positional first arg must NOT produce an unknown-subcommand violation."""
+    usage = "usage: foo [-h] [--format {json,text}] path\n\noptions:\n  -h\n"
+
+    class _FakeProber:
+        def top(self, tool):
+            return 0, usage
+
+        def sub(self, tool, sub):
+            return 0, usage
+
+    monkeypatch.setattr(ptc, "_Prober", lambda: _FakeProber())
+    monkeypatch.setattr(ptc, "extract_call_sites",
+                        lambda text, rel: [{"tool": "foo", "sub": "somearg",
+                                            "flags": [], "file": rel, "line": 1}])
+    monkeypatch.setattr(ptc, "extract_accessor_reads", lambda text, rel: [])
+    monkeypatch.setattr(ptc, "_scoped_files", lambda scope="all": [ROOT / "README.md"])
+    res = ptc.run_check("all")
+    assert not any(v["kind"] == "unknown-subcommand" for v in res["violations"]), res
+
+
