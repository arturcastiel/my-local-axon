@@ -285,9 +285,26 @@ def declared_subs(help_text: str) -> set[str] | None:
     """Subcommand/positional-action set from an argparse usage line; None when absent.
     argparse renders option CHOICES before positionals (e.g. `--format {json,text}`
     precedes `[{evaluate,chunk,...}]`), so the LAST {a,b,c} group is the action set —
-    the first-match form false-flagged retrieval-eval's real `chunk` action."""
-    matches = _USAGE_SUBS.findall(help_text.split("\n\n")[0])
-    return set(matches[-1].split(",")) if matches else None
+    the first-match form false-flagged retrieval-eval's real `chunk` action.
+
+    But a {a,b,c} group is *only* a subcommand set when it is a positional; an
+    option's choices metavar (`--format {json,text}`) is NOT. argparse renders the
+    latter immediately after the option string (`--format`/`[--format`), whereas a
+    positional group follows a *closed* token (`[-h]`) or the usage prefix. A
+    subparser-less tool whose sole {...} group is an option's choices must return
+    None (no subparsers) — otherwise those choices were mistaken for subcommands and
+    a valid positional call-site was flagged unknown-subcommand."""
+    usage = help_text.split("\n\n")[0]
+    positional_groups: list[str] = []
+    for m in _USAGE_SUBS.finditer(usage):
+        prev = usage[:m.start()].rstrip()
+        prev_token = prev.rsplit(None, 1)[-1] if prev else ""
+        # option-choices lead: `--opt` / `[--opt` / `-o` / `[-o`, but NOT a closed
+        # bracket token like `[-h]` (whose `]` ends the group before this one).
+        if re.match(r"\[?-{1,2}[A-Za-z]", prev_token) and not prev_token.endswith("]"):
+            continue
+        positional_groups.append(m.group(1))
+    return set(positional_groups[-1].split(",")) if positional_groups else None
 
 
