@@ -0,0 +1,52 @@
+"""B021 — probe_smoke must FAIL (not fail-open ACTIVE) when a tool's `--help`
+exits non-zero or times out. Previously both the non-zero branch and the
+TimeoutExpired branch returned {"status": "ACTIVE"}, so a broken ACTIVE tool
+without a specific probe was reported healthy, keeping counts['FAILED']==0 and
+L:health-score==100 — masking the failure from the kernel gates and menu."""
+import sys
+import textwrap
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+TOOLS = ROOT / "tools"
+sys.path.insert(0, str(TOOLS))
+
+import health  # noqa: E402
+
+
+def _write(tmp_path, body: str) -> str:
+    p = tmp_path / "broken_tool.py"
+    p.write_text(textwrap.dedent(body))
+    return str(p)
+
+
+def test_probe_smoke_fails_on_nonzero_help(tmp_path):
+    # A tool with an import/syntax error: `python tool.py --help` returns rc=1.
+    script = _write(tmp_path, """
+        import definitely_not_a_real_module  # ImportError before argparse
+        print("never reached")
+    """)
+    result = health.probe_smoke(script)
+    assert result["status"] == "FAILED", result
+
+
+def test_probe_smoke_fails_on_timeout(tmp_path, monkeypatch):
+    # Force the probe subprocess to time out; the TimeoutExpired branch must FAIL.
+    script = _write(tmp_path, """
+        import time
+        time.sleep(30)
+    """)
+    # Shrink the timeout budget so the test is fast.
+    monkeypatch.setenv("AXON_HEALTH_TIMEOUT_SCALE", "0.01")
+    result = health.probe_smoke(script)
+    assert result["status"] == "FAILED", result
+
+
+def test_probe_smoke_active_on_clean_help(tmp_path):
+    # The non-buggy path is preserved: a well-formed --help (rc=0) stays ACTIVE.
+    script = _write(tmp_path, """
+        import argparse
+        argparse.ArgumentParser().parse_args()
+    """)
+    result = health.probe_smoke(script)
+    assert result["status"] == "ACTIVE", result
