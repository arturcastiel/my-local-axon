+"""PR-23 — error-handling regressions for predicate / validator / programs_registry.
+
+Each test pins a concrete failure_scenario that crashed with an uncaught
+exception (or masked a failure as success) before the PR-23 fixes.
+"""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "tools"))
+
+import predicate  # noqa: E402
+
+PREDICATE = ROOT / "tools" / "predicate.py"
+VALIDATOR = ROOT / "tools" / "validator.py"
+REGISTRY = ROOT / "tools" / "programs_registry.py"
+
+
+# ── B011: `matches` with an invalid regex RHS ───────────────────────────────────
+
+def test_b011_matches_invalid_regex_raises_evalerror() -> None:
+    # re.error must be converted into the uniform EvalError envelope, not propagate.
+    with pytest.raises(predicate.EvalError) as exc:
+        predicate.evaluate_expr('name matches "["', {"state": {"name": "abc"}})
+    assert exc.value.code == "invalid_regex"
+
+
+def test_b011_matches_invalid_regex_cli_clean_envelope() -> None:
+    proc = subprocess.run(
+        [sys.executable, str(PREDICATE), "eval",
+         "--expr", 'name matches "["', "--ctx", '{"state":{"name":"abc"}}'],
+        capture_output=True, text=True,
+    )
+    # Clean JSON envelope + rc 1, not a traceback / rc>1.
+    assert proc.returncode == 1, proc.stderr
+    out = json.loads(proc.stdout)
+    assert out["error"] == "invalid_regex"
+    assert out["message"]
+
+
+# ── B060: `<non-string> in <string>` ────────────────────────────────────────────
+
+def test_b060_int_in_string_raises_evalerror() -> None:
+    with pytest.raises(predicate.EvalError) as exc:
+        predicate.evaluate_expr("5 in name", {"state": {"name": "abc"}})
+    assert exc.value.code == "type_mismatch"
+
+
+def test_b060_int_in_string_cli_clean_envelope() -> None:
+    proc = subprocess.run(
+        [sys.executable, str(PREDICATE), "eval",
+         "--expr", "5 in name", "--ctx", '{"state":{"name":"abc"}}'],
+        capture_output=True, text=True,
+    )
+    assert proc.returncode == 1, proc.stderr
+    out = json.loads(proc.stdout)
+    assert out["error"] == "type_mismatch"
+
+
+def test_b060_string_in_string_still_works() -> None:
+    # Preserve the non-buggy path: substring membership.
+    assert predicate.evaluate_expr('"b" in name', {"state": {"name": "abc"}}) is True
+
+
+# ── B065: validator `--data ''` (empty string, not None) ────────────────────────
+
+def test_b065_empty_data_clean_envelope() -> None:
+    proc = subprocess.run(
+        [sys.executable, str(VALIDATOR), "--data", "", "--type", "object"],
+        capture_output=True, text=True,
+    )
+    # Empty string is now routed through json.loads('') → JSONDecodeError → clean
+    # "Data error" envelope + rc 1, instead of open(None) TypeError traceback.
+    assert proc.returncode == 1, proc.stderr
+    out = json.loads(proc.stdout)
+    assert out["error"].startswith("Data error"), out
+
+
+# ── B061: programs_registry error paths must exit non-zero ──────────────────────
+
+def test_b061_generate_no_programs_dir_exits_nonzero(tmp_path: Path) -> None:
+    proc = subprocess.run(
+        [sys.executable, str(REGISTRY), "--workspace", str(tmp_path), "generate"],
+        capture_output=True, text=True,
+    )
+    out = json.loads(proc.stdout)
+    assert out["ok"] is False
+    assert proc.returncode != 0, "error path must not fail-open with exit 0"
+
+
+def test_b061_query_before_generate_exits_nonzero(tmp_path: Path) -> None:
+    proc = subprocess.run(
+        [sys.executable, str(REGISTRY), "--workspace", str(tmp_path), "query"],
+        capture_output=True, text=True,
+    )
+    out = json.loads(proc.stdout)
+    assert out["ok"] is False
+    assert proc.returncode != 0
+
+
+def test_b061_validate_before_generate_exits_nonzero(tmp_path: Path) -> None:
+    proc = subprocess.run(
+        [sys.executable, str(REGISTRY), "--workspace", str(tmp_path), "validate"],
+        capture_output=True, text=True,
+    )
+    out = json.loads(proc.stdout)
+    assert out["ok"] is False
+    assert proc.returncode != 0
