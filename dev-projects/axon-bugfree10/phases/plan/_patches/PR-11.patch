diff --git a/tests/test_memory_rollback_multistep.py b/tests/test_memory_rollback_multistep.py
new file mode 100644
index 0000000..6d5f897
--- /dev/null
+++ b/tests/test_memory_rollback_multistep.py
@@ -0,0 +1,61 @@
+"""B076: L: rollback must be a genuine multi-step undo, not a two-value oscillation.
+
+Pre-fix, rollback popped the most-recent prior value but then re-inserted the *current*
+value at the front of the history sidecar. That made history[1:] permanently unreachable
+and turned repeated rollback into a v(n-1)<->v(n) toggle — defeating the ROLLBACK_MAX=3
+multi-step-undo contract that `history`/`remaining_history` advertises.
+"""
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+MEM = ROOT / "tools" / "memory.py"
+
+
+def _run(*argv, ws):
+    return subprocess.run([sys.executable, str(MEM), *argv, "--workspace", str(ws)],
+                          capture_output=True, text=True, timeout=30)
+
+
+def _set(ws, key, value):
+    r = _run("set", "--scope", "L", "--key", key, "--value", value, ws=ws)
+    assert r.returncode == 0, r.stdout + r.stderr
+
+
+def _get(ws, key):
+    return json.loads(_run("get", "--scope", "L", "--key", key, ws=ws).stdout)["value"]
+
+
+def _rollback(ws, key):
+    return json.loads(_run("rollback", "--scope", "L", "--key", key, ws=ws).stdout)
+
+
+def test_rollback_walks_back_through_full_history(tmp_path):
+    for v in ("v1", "v2", "v3", "v4"):
+        _set(tmp_path, "foo", v)
+    # Sidecar is [v3, v2, v1]; file is v4. A correct multi-step undo walks v4->v3->v2->v1.
+    assert _get(tmp_path, "foo") == "v4"
+
+    d = _rollback(tmp_path, "foo")
+    assert d["restored_value"] == "v3" and _get(tmp_path, "foo") == "v3"
+
+    d = _rollback(tmp_path, "foo")
+    # Pre-fix this returned v4 (oscillation) and v2/v1 were unreachable forever.
+    assert d["restored_value"] == "v2", "rollback oscillated instead of walking history back"
+    assert _get(tmp_path, "foo") == "v2"
+
+    d = _rollback(tmp_path, "foo")
+    assert d["restored_value"] == "v1" and _get(tmp_path, "foo") == "v1"
+    assert d["remaining_history"] == 0
+
+
+def test_rollback_two_value_case_still_restores_prior(tmp_path):
+    # Guard the manifested contract: single prior value still restores correctly.
+    _set(tmp_path, "k1", "first")
+    _set(tmp_path, "k1", "second")
+    d = _rollback(tmp_path, "k1")
+    assert d["rolled_back"] is True
+    assert d["restored_value"] == "first"
+    assert _get(tmp_path, "k1") == "first"
