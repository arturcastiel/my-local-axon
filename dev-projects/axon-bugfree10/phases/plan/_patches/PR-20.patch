+"""
+Structural regression tests for PR-20 program-logic fixes (axon-bugfree10).
+
+Each program is pseudocode (AXON-LANG), so verification is structural: assert the
+corrected token/branch is present and the buggy token is gone. Tied 1:1 to the
+failure_scenario of each bug.
+"""
+from pathlib import Path
+
+from conftest import ROOT
+
+PROGRAMS = ROOT / "workspace" / "programs"
+
+
+def _text(name: str) -> str:
+    return (PROGRAMS / name).read_text(encoding="utf-8")
+
+
+def test_b048_discover_issues_initialized_before_dep_scan():
+    """`issues ← []` must precede the dependency-scan append, and the append must
+    emit issue objects (not plain strings) so STEP-4 impact filters keep them."""
+    t = _text("discover.md")
+    init_pos = t.index("issues ← []")
+    dep_pos = t.index("MAP(W:_deps-result.issues")
+    assert init_pos < dep_pos, "issues must be initialized before the dependency append"
+    # No second reset after the dependency block that would wipe the entries.
+    assert t.count("issues ← []") == 1, "the redundant reset that discarded dep issues is gone"
+    # Dependency entries carry the object shape the render loops require.
+    assert 'type: "dependency"' in t
+    assert 'impact: (i.impact | "medium"' in t
+    # The old plain-string append is gone.
+    assert '"dependency: {i}"' not in t
+
+
+def test_b049_quality_loop_findings_json_defined():
+    """`findings-json` must be assigned (as a file path), the findings serialized to it,
+    and only then interpolated into the report call. The report tool reads --findings as
+    a path (json.loads(Path(...).read_text())), so raw JSON content would not work."""
+    t = _text("quality-loop.md")
+    assign_pos = t.index("findings-json ←")
+    write_pos = t.index("WRITE(findings-json, TO-JSON(findings))")
+    use_pos = t.index("--findings {findings-json}")
+    assert assign_pos < write_pos < use_pos, (
+        "findings-json must be assigned a path, written to, then used")
+    # It must be a path (interpolated string), not the raw JSON blob passed as a filename.
+    assert "findings-json ← TO-JSON(findings)" not in t
+
+
+def test_b050_versions_arg1_fallback():
+    """versions must fall back to the generic W:_arg1 tokenizer bridge key."""
+    t = _text("versions.md")
+    assert "RETRIEVE(W:_versions-target) | RETRIEVE(W:_arg1) → target" in t
+
+
+def test_b084_audit_to_study_notes_dir_uses_slug_path():
+    """project is a slug string; notes-dir must build the path from it, not `.path`."""
+    t = _text("audit-to-study.md")
+    assert "{W:myaxon-dev-projects}/{project}/shadow/audit-feedback/" in t
+    assert "{project.path}/shadow/audit-feedback/" not in t
+
+
+def test_b085_axon_compare_no_undefined_coverage_pct():
+    """`coverage-pct` was never assigned; the gap-area line must use the retained
+    dim-compilation score instead."""
+    t = _text("axon-compare.md")
+    assert "{coverage-pct}" not in t
+    assert "{dim-compilation}/9" in t
