@@ -27,15 +27,26 @@ TOOL(context, status) → W:_ctx-report
 
 ## STEP 2 — Scan programs for context hygiene issues
 TOOL(deps, check) → W:_deps-result
-# LOW fix (axon-bugfix01): this scan was computed and then never read — surface it.
-IF W:_deps-result ≠ ∅ AND W:_deps-result.issues | [] IS NOT EMPTY →
-  issues ← issues + MAP(W:_deps-result.issues, i → "dependency: {i}")
 
 programs-path ← RETRIEVE(W:ws-programs)
 programs      ← SCAN(programs-path, "*.md", exclude="compiled/,INDEX.md")
 
 issues ← []
 
+# LOW fix (axon-bugfix01): this scan was computed and then never read — surface it.
+# Emit each dependency issue as a proper issue object (program/type/impact/fix) so it
+# is counted, sorted by impact (STEP 4), and rendered by the loops below. The list is
+# initialized ABOVE this block so these entries are not referenced-before-init and
+# are not wiped by a later reset. Plain strings would be dropped by the impact FIND
+# filters and crash the render loops, so each entry carries the object shape.
+IF W:_deps-result ≠ ∅ AND (W:_deps-result.issues | []) IS NOT EMPTY →
+  issues ← issues + MAP(W:_deps-result.issues, i → {
+    program: (i.program | "workspace"),
+    type: "dependency",
+    impact: (i.impact | "medium"),
+    fix: "Dependency issue: {i.message | i}"
+  })
+
 LOOP(∀ p ∈ programs) {
   PROGRESS(i, programs.count, p.name)
   READ(p.path) → W:_prog-text
diff --git a/workspace/programs/quality-loop.md b/workspace/programs/quality-loop.md
index 3a83ce2..a12e64d 100644
--- a/workspace/programs/quality-loop.md
+++ b/workspace/programs/quality-loop.md
@@ -58,6 +58,13 @@ mode ← IF ramp.s_fix_authorized ≡ true → "s-fix" ELSE → "report-only"
 ∀ f in FILTER(verified, shared_surface ≡ true AND severity ≡ "fix") →
   DERIVE(prepared-diff, f)   # written into the cycle report, never applied
 report-path ← "{W:myaxon-dev-projects}/{W:code-dev-project | 'axon-plus'}/quality/cycle-{cycle}.md"
+# The report tool reads --findings as a PATH to a scan-output JSON file
+# (json.loads(Path(--findings).read_text())), so persist the post-verification findings
+# object to disk and pass that path — not the raw JSON, and not the previously-undefined
+# {findings-json}. The verify loop above stamped f.verified on findings.findings, so the
+# serialized file carries the verified column the report renders.
+findings-json ← "{W:myaxon-dev-projects}/{W:code-dev-project | 'axon-plus'}/quality/_scan-{cycle}.json"
+WRITE(findings-json, TO-JSON(findings))
 TOOL(quality-loop, report, "--findings {findings-json} --cycle {cycle} --mode report-only --out {report-path}")
 
 STORE(W:active-phase, "quality-loop:converge")
