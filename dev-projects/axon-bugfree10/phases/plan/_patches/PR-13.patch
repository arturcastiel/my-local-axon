+def _vault_counts(graph: dict) -> tuple[int, int]:
+    """Compute the counts build_vault() actually produces from `graph`:
+    (file-note count, cross-file edge count) — NOT the raw symbol-node /
+    total-link counts. Kept in lock-step with build_vault's grouping logic so
+    the 'unchanged' fast-path reports the same card the initial build did."""
+    nodes = graph.get("nodes", [])
+    links = graph.get("links", graph.get("edges", []))
+    id_file: dict[str, str] = {}
+    files: set[str] = set()
+    for n in nodes:
+        sf = n.get("source_file") or "(unknown)"
+        files.add(sf)
+        id_file[str(n.get("id"))] = sf
+    edge_count = 0
+    for e in links:
+        sf = id_file.get(str(e.get("source")))
+        tf = id_file.get(str(e.get("target")))
+        if sf and tf and sf != tf:
+            edge_count += 1
+    return len(files), edge_count
+
