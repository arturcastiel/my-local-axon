diff --git a/tests/test_pr13_data_integrity.py b/tests/test_pr13_data_integrity.py
new file mode 100644
index 0000000..0c02358
--- /dev/null
+++ b/tests/test_pr13_data_integrity.py
@@ -0,0 +1,83 @@
+"""PR-13 data-integrity regressions:
+  B073 index.append_table_row — must not merge the new row onto the line
+        following the table (e.g. a `## SECTION` header) nor inject a blank line.
+  B015 _axon_rollback.restore — restoring the oldest snapshot while at cap must
+        not evict-then-crash on the chosen snapshot.
+"""
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT / "tools"))
+
+import index                # noqa: E402
+import _axon_rollback       # noqa: E402
+
+
+# ── B073: append_table_row ────────────────────────────────────────────────────
+
+def test_append_row_before_following_section_header():
+    """A CHATS table immediately followed (no blank line) by `## ARCHIVE`."""
+    content = (
+        "## CHATS\n"
+        "| Folder | Chat | Goal | Created | Active | Status |\n"
+        "| --- | --- | --- | --- | --- | --- |\n"
+        "| f1 | c1 | g1 | 2026-01-01 | 2026-01-01 | active |\n"
+        "## ARCHIVE\n"
+        "old stuff\n"
+    )
+    row = "| f2 | c2 | g2 | 2026-01-02 | 2026-01-02 | active |"
+    out = index.append_table_row(content, "CHATS", row)
+    lines = out.split("\n")
+    # the header must survive intact on its own line
+    assert "## ARCHIVE" in lines, "section header was destroyed"
+    # the new row must be its own line, never merged with the header
+    assert row in lines
+    assert not any(l.startswith("|") and l.rstrip().endswith("## ARCHIVE") for l in lines)
+    assert "## ARCHIVE" not in row  # sanity
+    # no spurious blank line splitting the table: the new row directly follows f1
+    idx = lines.index(row)
+    assert lines[idx - 1] == "| f1 | c1 | g1 | 2026-01-01 | 2026-01-01 | active |"
+    # and it is immediately followed by the header (own line)
+    assert lines[idx + 1] == "## ARCHIVE"
+
+
+def test_append_row_table_last_in_file_no_blank_line():
+    """Regression guard for the normal case (table is the last content)."""
+    content = (
+        "## CHATS\n"
+        "| Folder | Chat | Goal | Created | Active | Status |\n"
+        "| --- | --- | --- | --- | --- | --- |\n"
+        "| f1 | c1 | g1 | 2026-01-01 | 2026-01-01 | active |\n"
+    )
+    row = "| f2 | c2 | g2 | 2026-01-02 | 2026-01-02 | active |"
+    out = index.append_table_row(content, "CHATS", row)
+    assert "\n\n" not in out, "spurious blank line injected"
+    assert out.count(row) == 1
+    lines = [l for l in out.split("\n") if l]
+    assert lines[-1] == row
+
+
+# ── B015: restore at cap must not evict-then-crash the chosen snapshot ─────────
+
+def test_restore_oldest_at_cap_does_not_evict_and_crash(tmp_path):
+    target = tmp_path / "doc.md"
+    cap = _axon_rollback.DEFAULT_CAP  # 3
+
+    # Build up exactly `cap` snapshots by editing then snapshotting.
+    contents = ["v1-oldest", "v2", "v3"]
+    for c in contents:
+        target.write_text(c)
+        _axon_rollback.snapshot(target)
+    # now write the current (un-snapshotted) contents
+    target.write_text("current")
+
+    snaps = _axon_rollback.list_snapshots(target)
+    assert len(snaps) == cap
+    oldest = snaps[-1]                       # version == cap == the oldest
+    assert oldest.read_text() == "v1-oldest"
+
+    # Restore the oldest version while at cap. Must not raise, must restore it.
+    restored = _axon_rollback.restore(target, version=cap)
+    assert restored is not None
+    assert target.read_text() == "v1-oldest", "target was not restored to the oldest snapshot"
diff --git a/tools/_axon_rollback.py b/tools/_axon_rollback.py
index 0fe22ed..bf63518 100644
--- a/tools/_axon_rollback.py
+++ b/tools/_axon_rollback.py
@@ -103,9 +103,14 @@ def restore(target: Union[str, Path], version: int = 1) -> Optional[Path]:
     if version < 1 or version > len(snaps):
         return None
     chosen = snaps[version - 1]
+    # Read the chosen snapshot BEFORE self-snapshotting: snapshot() enforces the
+    # FIFO cap and, when the .rollback dir is already at cap, evicts the oldest
+    # snapshot — which may be `chosen` itself (restoring the oldest version at
+    # cap). Reading first ensures the bytes survive that eviction.
+    chosen_text = chosen.read_text()
     # Self-snapshot the current contents so the restore is reversible
     snapshot(target)
-    atomic_write(target, chosen.read_text())
+    atomic_write(target, chosen_text)
     return chosen
 
 
