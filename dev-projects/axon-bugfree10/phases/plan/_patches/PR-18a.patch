+"""Regression (PR-18a): code-dev dispatch / CASE routing — audit (markdown logic).
+
+These are interpreted AXON-LANG programs (not unit-executable), so the assertions are static
+checks over the program TEXT that lock the corrected control-flow for three routing bugs:
+
+- B044 (code-dev-state.md): the `actions` subcommand is advertised in desc/usage/the FAIL list but
+  the CASE had no `actions` arm, so `code-dev state actions` fell through the `*` wildcard and
+  hard-failed. Fix: an `actions → EXEC(auto-actions.md)` branch before the wildcard.
+- B046 (code-dev.md): the `IF cmd ≡ "phase"` block read the never-written key W:code-dev-phase-cmd,
+  so `code-dev phase list` always defaulted to "new" and scaffolded a phase instead of listing.
+  Fix: dispatch off the parsed second token `sub`.
+- B042 (code-dev-safety-freeze.md): the SESSION HOOK hardcoded state=frozen (anchor=freeze)
+  regardless of mode, so `code-dev thaw` re-froze the session at entry. Fix: read mode BEFORE the
+  hook and branch the checkpoint/transition (thaw → --state active).
+"""
+from pathlib import Path
+
+PROG = Path(__file__).resolve().parent.parent / "workspace" / "programs"
+STATE = (PROG / "code-dev-state.md").read_text(encoding="utf-8")
+CODEDEV = (PROG / "code-dev.md").read_text(encoding="utf-8")
+FREEZE = (PROG / "code-dev-safety-freeze.md").read_text(encoding="utf-8")
+
+
+# ── B044: state actions has a CASE arm ──────────────────────────────────────
+def test_state_actions_has_dispatch_arm():
+    # the documented `actions` subcommand now routes, instead of hitting the `*` wildcard FAIL
+    assert "actions  → EXEC(workspace/programs/auto-actions.md)" in STATE
+    # and it precedes the wildcard so it wins
+    assert STATE.index("actions  → EXEC(workspace/programs/auto-actions.md)") < STATE.index(
+        '*        → FAIL(code-dev-state,'
+    )
+
+
+# ── B046: phase dispatch reads the parsed second token, not a dead key ───────
+def test_phase_dispatch_uses_parsed_sub_token():
+    # the never-written key is gone; dispatch is off the parsed `sub`
+    assert "RETRIEVE(W:code-dev-phase-cmd)" not in CODEDEV
+    assert "phase-sub ← sub | \"new\"" in CODEDEV
+    # the list handler is now reachable (kept intact)
+    assert 'IF phase-sub ≡ "list" →' in CODEDEV
+
+
+# ── B042: session hook is mode-aware (thaw does not re-freeze) ───────────────
+def test_freeze_session_hook_is_mode_aware():
+    hook = FREEZE.split("## SESSION HOOK", 1)[1].split("project ← RETRIEVE", 1)[0]
+    # mode is resolved BEFORE any session transition
+    assert hook.index('mode ← RETRIEVE(W:code-dev-freeze-mode)') < hook.index(
+        'TOOL(session, transition'
+    )
+    # freeze branch → frozen; thaw branch → active (not a hardcoded frozen)
+    assert 'TOOL(session, transition, "--path {session-path} --state frozen")' in hook
+    assert 'TOOL(session, transition, "--path {session-path} --state active")' in hook
+    assert 'IF mode ≡ "freeze" →' in hook
+
+
+def test_freeze_no_unconditional_frozen_transition_at_entry():
+    # the pre-fix bug was a bare, always-run transition to frozen at the very top of the hook,
+    # before mode was read. Assert the transition now lives inside the mode branch.
+    hook = FREEZE.split("## SESSION HOOK", 1)[1].split("project ← RETRIEVE", 1)[0]
+    frozen_idx = hook.index('--state frozen')
+    branch_idx = hook.index('IF mode ≡ "freeze" →')
+    assert branch_idx < frozen_idx, "frozen transition must be gated by the mode branch"
