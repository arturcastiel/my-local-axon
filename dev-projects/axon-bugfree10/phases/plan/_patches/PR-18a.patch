--- a/workspace/programs/code-dev-safety-freeze.md
+++ b/workspace/programs/code-dev-safety-freeze.md
@@ -31,9 +31,16 @@ ASSERT(L:cognition-frame ≡ "AXON-OS") | HALT("Identity lost — run: boot axon
 STORE(W:active-program, "code-dev-safety-freeze")
 
 ## SESSION HOOK (PR-9)
+# The hook must respect mode (freeze|thaw) — a bare hardcode re-froze the session on `code-dev thaw`,
+# leaving session state permanently inconsistent with the thawed project. Read mode BEFORE the hook.
+mode ← RETRIEVE(W:code-dev-freeze-mode) | "freeze"   # freeze | thaw
 session-path ← "{W:myaxon-dev-projects}/{W:code-dev-project}/_session.md"
-TOOL(session, checkpoint, "--path {session-path} --turn {W:turn-counter} --anchor freeze --summary pre-freeze")
-TOOL(session, transition, "--path {session-path} --state frozen")
+IF mode ≡ "freeze" →
+  TOOL(session, checkpoint, "--path {session-path} --turn {W:turn-counter} --anchor freeze --summary pre-freeze")
+  TOOL(session, transition, "--path {session-path} --state frozen")
+ELSE →
+  TOOL(session, checkpoint, "--path {session-path} --turn {W:turn-counter} --anchor thaw --summary pre-thaw")
+  TOOL(session, transition, "--path {session-path} --state active")
 
 project ← RETRIEVE(W:code-dev-project)
 ASSERT(project ≠ ∅) | FAIL(code-dev-safety-freeze, "No project loaded.")
@@ -41,7 +48,7 @@ proj-dir ← "{W:myaxon-dev-projects}/{project}"
 meta ← READ("{proj-dir}/_meta.md")
 phase-dir ← "{proj-dir}/phases/{meta.phase}"
 phase-meta ← READ("{phase-dir}/_meta.md")
-mode ← RETRIEVE(W:code-dev-freeze-mode) | "freeze"   # freeze | thaw
+# mode already resolved at the SESSION HOOK above (freeze | thaw)
 ts ← TOOL(clock)
 
 IF mode ≡ "freeze" →
