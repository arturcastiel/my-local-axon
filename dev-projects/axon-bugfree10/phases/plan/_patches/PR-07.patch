@@ -0,0 +1,97 @@
+"""PR-07 regression locks — trace gates.
+
+B016 (dag_consistency): next-conditional edges must be validated like
+      next-suggests; a dangling conditional edge is a fail-closed error.
+B020 (drift): a no-program trace (expected=[]) must stay stable after a
+      recorded tool — not flip to diverged/halt (init --no-program contract).
+B024 (pr_drift): a CamelCase-only acceptance item must be classified as
+      anchored and verified against the diff, not silently passed as weak.
+"""
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT / "tools"))
+
+import dag_consistency as dc  # noqa: E402
+import drift  # noqa: E402
+import pr_drift  # noqa: E402
+
+
+# ── B016: next-conditional dangling edges are errors ────────────────────────
+def _prog_cond(d, name, next_conditional):
+    (d / f"{name}.md").write_text(
+        f"# PROGRAM: {name}\n#   next-conditional: [{next_conditional}]\n")
+
+
+def test_dangling_next_conditional_edge_is_error(tmp_path):
+    pd = tmp_path / "programs"; pd.mkdir()
+    _prog_cond(pd, "alpha", "does-not-exist")
+    res = dc.check(str(tmp_path), programs_dir=str(pd),
+                   registry_path=str(tmp_path / "none.json"))
+    codes = [e["code"] for e in res["errors"]]
+    assert "DANGLING_SYNAPSE_EDGE" in codes
+    assert res["ok"] is False
+    assert any("does-not-exist" in e["detail"] for e in res["errors"])
+
+
+def test_valid_next_conditional_edge_passes(tmp_path):
+    pd = tmp_path / "programs"; pd.mkdir()
+    _prog_cond(pd, "alpha", "beta")
+    (pd / "beta.md").write_text("# PROGRAM: beta\n")
+    res = dc.check(str(tmp_path), programs_dir=str(pd),
+                   registry_path=str(tmp_path / "none.json"))
+    assert not any(e["code"] == "DANGLING_SYNAPSE_EDGE" for e in res["errors"])
+
+
+# ── B020: no-program trace stays stable after a recorded tool ───────────────
+def test_no_program_trace_stays_stable_after_record():
+    # expected empty (no-program), actual has one entry -> must be stable (0.0),
+    # not full divergence (1.0).
+    assert drift.compute_score([], ["clock"]) == 0.0
+    assert drift.classify(drift.compute_score([], ["clock"])) == "stable"
+
+
+def test_no_program_gate_stable_after_record(tmp_path):
+    ws = tmp_path / "ws"
+    (ws / "working").mkdir(parents=True)
+
+    class A:
+        workspace = str(ws)
+    # init --no-program
+    a = A(); a.no_program = True; a.program = None
+    drift.cmd_init(a)
+    # record a tool
+    r = A(); r.tool = "clock"; r.type = None; r.detail = None
+    drift.cmd_record(r)
+    gate = drift._evaluate_gate(str(ws))
+    assert gate["state"] == "stable"
+    assert gate["decision"] == "quiet"
+    assert gate["modifier"] == 0
+
+
+# ── B024: CamelCase-only acceptance item is anchored + verified ─────────────
+def test_camelcase_token_is_anchored():
+    # Regression: previously _is_anchored(t.lower()) defeated CamelCase detection.
+    assert pr_drift._is_anchored("AgentCard") is True
+
+
+def test_camelcase_only_item_is_verified_not_silently_passed(tmp_path, monkeypatch):
+    spec = tmp_path / "PR-01.md"
+    spec.write_text("## Acceptance\n- [ ] Emit a valid AgentCard envelope\n")
+    # Diff that does NOT add AgentCard -> the item must be reported unmet.
+    monkeypatch.setattr(pr_drift, "_diff_text",
+                        lambda repo: "+++ b/foo.py\n+def helper():\n+    return 1\n")
+    res = pr_drift.drift(spec, tmp_path)
+    assert res["ok"] is False
+    assert any("AgentCard" in u for u in res["unmet"])
+
+    # And when the diff DOES add AgentCard, the item is satisfied.
+    monkeypatch.setattr(pr_drift, "_diff_text",
+                        lambda repo: "+++ b/card.py\n+class AgentCard:\n+    pass\n")
+    res2 = pr_drift.drift(spec, tmp_path)
+    assert res2["ok"] is True
+    assert res2["unmet"] == []
