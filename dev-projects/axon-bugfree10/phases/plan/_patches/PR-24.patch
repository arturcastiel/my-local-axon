+def test_health_score_read_via_memory_not_kv_store(monkeypatch, tmp_path):
+    """B012: L:health-score lives in the longterm .md store (health.py --persist is its
+    single writer). kv-store REFUSES the L: namespace (C9 split-brain guard), so reading
+    it through kv-store always yields an error → score None → health falsely 'unknown'.
+    The canonical reader is `memory get --scope L`; assert self-care uses it and picks up
+    a healthy persisted score."""
+    calls = []
+
+    def fake_axon(*args, timeout=120):
+        a = [str(x) for x in args]
+        calls.append(tuple(a))
+        if a[:2] == ["kv-store", "get"]:  # real kv_store.py refuses L: and exits 2
+            return 2, json.dumps({"error": "kv-store refuses the L: namespace"})
+        if a[:2] == ["memory", "get"]:
+            return 0, json.dumps({"scope": "L", "key": "health-score",
+                                  "value": "95", "found": True})
+        if a[0] == "freshness":
+            return 0, json.dumps({"stale": []})
+        if a[0] == "cron":
+            return 0, json.dumps({"overdue_count": 0, "count": 0})
+        if a[0] == "drift":
+            return 0, json.dumps({"state": "stable"})
+        if a[0] == "igap":
+            return 0, json.dumps({"total": 0})
+        if a[0] == "lint-path-vars":
+            return 0, json.dumps({"violations": []})
+        return 0, "{}"
+
+    monkeypatch.setattr(self_care, "_axon", fake_axon)
+    rep = self_care.run_check(ws=str(tmp_path), claude_dir=_wire(tmp_path))
+
+    assert ("memory", "get", "--scope", "L", "--key", "health-score") in calls
+    assert not any(c[:2] == ("kv-store", "get") for c in calls)
+    assert rep["areas"]["health"]["score"] == "95"
+    assert rep["areas"]["health"]["ok"] is True
+    assert not any(item.startswith("health:") for item in rep["needs_attention"])
+
+
