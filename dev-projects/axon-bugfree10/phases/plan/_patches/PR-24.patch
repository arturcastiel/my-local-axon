+def test_incomplete_status_is_not_a_complete_claim(ws, projects):
+    """B064: 'complete' is matched as a WHOLE WORD — the substring inside 'incomplete'
+    (the exact opposite claim) must NOT trigger a complete-claim-unbacked finding even
+    though the manifest legitimately still has non-done phases."""
+    _project(projects, "still-going", "incomplete", "plan",
+             {"study": "done"})  # plan/pr/log/audit pending — consistent with 'incomplete'
+    res = self_care.pointer_check(str(ws), projects_dir=str(projects))
+    assert _findings(res, "complete-claim-unbacked") == []
+
+
+def test_completed_status_is_still_a_complete_claim(ws, projects):
+    """The whole-word fix must not under-match: 'completed' is still a completion claim,
+    so an unbacked manifest under 'completed' must still be flagged."""
+    _project(projects, "claims-done", "completed", "pr",
+             {"study": "done", "plan": "done"})  # pr/log/audit pending
+    res = self_care.pointer_check(str(ws), projects_dir=str(projects))
+    assert len(_findings(res, "complete-claim-unbacked")) == 1
+
+
