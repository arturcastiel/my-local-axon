+    # so the caller falls back to the prior behaviour rather than passing garbage.
+    assert run_mod._tool_argv("DERIVE(verify-probe, f") == []
+
+
+def test_handle_line_passes_subcommand_args_to_registered_tool(monkeypatch):
+    """B030 repro: a `TOOL(<tool>, report, "--flags ...")` line must invoke the
+    tool WITH the subcommand + flags. Before the fix run_script was called with
+    no argv, so a tool with a required subparser argparse-errored (exit 2)."""
+    # Pick a registered tool whose script actually exists on disk.
+    tool_name = next(
+        (n for n, s in run_mod.TOOL_SCRIPTS.items() if s and Path(s).exists()),
+        None,
+    )
+    assert tool_name is not None, "expected at least one registered ACTIVE tool"
+
+    calls = []
+
+    def fake_run_script(script, extra_args=None):
+        calls.append((script, extra_args))
+        return {"ok": True}
+
+    monkeypatch.setattr(run_mod, "run_script", fake_run_script)
+
+    line = f'TOOL({tool_name}, report, "--findings F --cycle 3 --out /tmp/c.md")'
+    res = run_mod.handle_line(line, "/tmp/ws", tool_name)
+
+    assert res["op"] == "TOOL" and res["tool"] == tool_name
+    assert len(calls) == 1
+    _script, argv = calls[0]
+    assert argv == ["report", "--findings", "F", "--cycle", "3", "--out", "/tmp/c.md"]
