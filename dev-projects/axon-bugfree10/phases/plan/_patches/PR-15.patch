+import argparse, json, os, re, shlex, subprocess, sys
 from datetime import datetime, timezone
 from pathlib import Path
 from _axon_paths import default_workspace, TOOLS, AXON_ROOT
@@ -31,6 +31,34 @@ RE_CLEAR    = re.compile(r'CLEAR\((W|L):([\w-]+)\)')
 RE_APPEND   = re.compile(r'APPEND\(E:([\w-]+),\s*(.+)\)')
 RE_COMMENT  = re.compile(r'^#')
 RE_HEADER   = re.compile(r'^#+ |^---|^Source:|^Compiled:|^Tokens:|^Warnings:|^Version:')
+# TOOL() argument shape: a bare subcommand, optionally followed by a quoted flag
+# string, e.g. `report, "--findings x --out y"`. Anything that is not a plain
+# subcommand (e.g. an unresolved semantic arg like `DERIVE(...)`) is left to the
+# agent by returning no argv (fall back to the prior argless invocation).
+RE_TOOL_ARGS = re.compile(r'^([\w-]+)\s*(?:,\s*(.*))?$', re.DOTALL)
+
+def _tool_argv(rest):
+    """Convert RE_TOOL group(2) into a subprocess argv list.
+
+    B030: the TOOL branch used to invoke registered tools with NO arguments,
+    silently dropping the subcommand + flags captured here. A call like
+    `TOOL(quality-loop, report, "--findings ... --out ...")` then hit the tool's
+    required subparser and argparse-errored (exit 2), so the intended effect
+    never happened. Passing the parsed argv restores the invocation.
+    """
+    if not rest:
+        return []
+    m = RE_TOOL_ARGS.match(rest.strip())
+    if not m:
+        return []
+    argv = [m.group(1)]
+    argstr = (m.group(2) or "").strip().strip('"\'')
+    if argstr:
+        try:
+            argv += shlex.split(argstr)
+        except ValueError:
+            argv += argstr.split()
+    return argv
 
 def run_script(script, extra_args=None):
     cmd = [sys.executable, script] + (extra_args or [])
