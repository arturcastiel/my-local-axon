+++ b/tests/test_tools_kernel.py
@@ -1052,6 +1052,36 @@ class TestDispatchAutoTune:
         assert m is not None
         assert float(m.group(1)) > 0.65
 
+    def test_auto_tune_persists_when_confidence_line_absent(self, tmp_ws):
+        """B071: when the pref file has NO `dispatch-confidence:` line the re.sub
+        used to silently no-op — the tool reported `threshold_adjusted` while
+        persisting nothing, so current_threshold() kept reading the default and
+        the tool re-reported the same phantom adjustment forever. The line must
+        now be appended so the reported value actually takes effect."""
+        self._seed_index(tmp_ws)  # seed pref file has NO dispatch-confidence line
+        prefs_path = tmp_ws / "preferences" / "smart-dispatch.md"
+        assert "dispatch-confidence:" not in prefs_path.read_text()
+        kv = tmp_ws / "memory" / "kv-store"
+        kv.mkdir(parents=True, exist_ok=True)
+        (kv / "dispatch-auto-tune.md").write_text("true")
+        run([self.T, "match", "--query", "alpha worker",
+             "--workspace", str(tmp_ws)])
+        last_adjust = None
+        for _ in range(10):
+            out, _rc = run([self.T, "feedback", "--id", "fake", "--result", "no",
+                            "--workspace", str(tmp_ws)])
+            if out.get("threshold_adjusted") is not None:
+                last_adjust = out
+        assert last_adjust is not None, "auto-tune never reported an adjustment"
+        # The reported adjustment must be persisted (was a phantom no-op before).
+        text = prefs_path.read_text()
+        import re as _re
+        m = _re.search(r"dispatch-confidence:\s*([\d.]+)", text)
+        assert m is not None, "dispatch-confidence line was never written"
+        persisted = float(m.group(1))
+        assert persisted > 0.65
+        assert abs(persisted - float(last_adjust["threshold_adjusted"])) < 1e-9
+
 
