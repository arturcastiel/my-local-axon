       → "  Architecture: {arch-extra}"
@@ -241,7 +233,6 @@ LOOP(true) {
   # AXON produces plan sections
   plan-sections ← DERIVE({
     context:     study.goal + "\n" + arch-extra,
-    codebase:    search-results,
     constraints: EXTRACT(study, "Constraints"),
     tech:        tech-stack,
   }, output="high-level plan with sections per major area of change")
