+def test_run_one_records_repo_sha_of_real_repo(tmp_path, monkeypatch):
+    # B066: run_one must stamp repo_sha from the REAL repo (ROOT), not from the
+    # git-archive checkout — that checkout has no .git, so repo_sha(checkout) is
+    # ALWAYS 'unknown', silently destroying which-commit-was-tested provenance.
+    checkout = tmp_path / "checkout"
+    checkout.mkdir()
+    assert C.repo_sha(checkout) == "unknown"   # the .git-less archive → 'unknown' (the bug's cause)
+
+    seen = {}
+
+    def spy(root):
+        seen["root"] = Path(root)
+        return "deadbee"
+
+    monkeypatch.setattr(C, "repo_sha", spy)
+
+    # Stub the spawn + grade so no `claude` agent is launched.
+    fake_dae = type(sys)("dual_agent_eval")
+
+    class _Backend:
+        def __init__(self, model, cwd=None):
+            pass
+
+        def __call__(self, msgs):
+            return "AXON · OS STATE · MODES"
+
+    fake_dae.ClaudeCliBackend = _Backend
+    fake_cs = type(sys)("conformance_scorecard")
+    fake_cs.grade = lambda scenario, transcript, tier: {
+        "pass": True, "missing_must_mention": [], "anti_pattern_hits": []}
+    monkeypatch.setitem(sys.modules, "dual_agent_eval", fake_dae)
+    monkeypatch.setitem(sys.modules, "conformance_scorecard", fake_cs)
+    monkeypatch.setattr(C, "detect_tier", lambda m: "standard")
+
+    task = C.load_tasks()[0]
+    home = tmp_path / "home"
+    home.mkdir()
+    rec = C.run_one(task, "sonnet", C.load_rubric(), clean_checkout=checkout,
+                    isolated_home=home, transcript_dir=tmp_path / "t")
+    assert seen["root"] == C.ROOT, "repo_sha must be computed against the real repo ROOT"
+    assert rec["repo_sha"] == "deadbee"        # not 'unknown'
+
+
