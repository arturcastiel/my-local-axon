+def test_doctrine_host_mirror_written_in_governed_path(tmp_path, monkeypatch):
+    """B022: _doctrine_host_mirror must add tools/ to sys.path before importing _axon_paths.
+
+    In the sentinel-governed (primary) path, _axon_active() returns True WITHOUT inserting
+    tools/ into sys.path, and _doctrine_host_mirror runs BEFORE _surface_open_accountability
+    (the only other function that inserts tools/). Before the fix `from _axon_paths import
+    default_workspace` raised ImportError (swallowed by the bare except), so the host-side
+    tamper-evidence mirror was never written — defeating the whole control.
+    """
+    # A governed tmp AXON root that _axon_paths resolves to via $AXON_ROOT (needs the sentinel).
+    axon_root = tmp_path
+    (axon_root / ".axon-governed").write_text("", encoding="utf-8")
+    (axon_root / "workspace").mkdir()
+    state = axon_root / "axon" / "state"
+    state.mkdir(parents=True)
+    (state / "doctrine-current-node.json").write_text(
+        json.dumps({"run_id": "R1", "node": "N1", "kind": "K1"}), encoding="utf-8")
+    monkeypatch.setenv("AXON_ROOT", str(axon_root))
+
+    mod = _load_verify_stop(SENTINEL)
+
+    # Reproduce the governed primary path: tools/ NOT on sys.path, path-resolver not cached.
+    real_tools = str(mod.TOOLS)
+    monkeypatch.setattr(sys, "path", [p for p in sys.path if p != real_tools])
+    monkeypatch.delitem(sys.modules, "_axon_paths", raising=False)
+    monkeypatch.delitem(sys.modules, "_longterm", raising=False)
+
+    mod._doctrine_host_mirror()
+
+    mirror = state / "doctrine-host-mirror.jsonl"
+    assert mirror.exists(), "host mirror must be written in the sentinel-governed path"
+    row = json.loads(mirror.read_text(encoding="utf-8").splitlines()[0])
+    assert row["actor"] == "host-stop-hook"
+    assert row["run_id"] == "R1" and row["node"] == "N1" and row["kind"] == "K1"
+
+
