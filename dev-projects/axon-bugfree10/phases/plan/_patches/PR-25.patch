+"""PR-25 — kernel tool logic/format regression tests.
+
+Each test pins a concrete failure_scenario from the bug specs and fails against the
+pre-fix code, passes after:
+
+  B057 _axon_lib.usage_record — ts must be plain isoformat() (no trailing 'Z'), else
+        usage.py's datetime.fromisoformat readers silently drop the row.
+  B058 clock._fmt          — unix must be correct on a non-UTC host (naive .timestamp()
+        skews it by the host offset).
+  B059 liveness_lint       — the autonomous_mode.authorized seam must not treat prose
+        'authorized (' as a production caller.
+  B062 redact              — hit start/end must be offsets into the ORIGINAL text.
+  B063 rules_loader.audit  — 'R-1' must not be counted as referenced by 'R-10'.
+"""
+from __future__ import annotations
+
+import json
+import os
+import sys
+from datetime import datetime
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT / "tools"))
+
+
+# ── B057 ─────────────────────────────────────────────────────────────────────
+def test_usage_record_ts_is_parseable(tmp_path):
+    import _axon_lib
+
+    ws = tmp_path / "workspace"
+    ws.mkdir()
+    _axon_lib.usage_record(str(ws), kind="program", name="menu")
+    log = ws / "memory" / "longterm" / "usage-log.jsonl"
+    entry = json.loads(log.read_text().splitlines()[0])
+    # The old code wrote '...+00:00Z' which raises ValueError here.
+    parsed = datetime.fromisoformat(entry["ts"])
+    assert parsed is not None
+    assert not entry["ts"].endswith("Z")
+
+
+# ── B058 ─────────────────────────────────────────────────────────────────────
+def test_clock_unix_matches_iso_instant(monkeypatch):
+    # Force a non-UTC local timezone so a naive .timestamp() would skew unix.
+    monkeypatch.setenv("TZ", "Europe/Amsterdam")
+    import time as _time
+
+    if hasattr(_time, "tzset"):
+        _time.tzset()
+    try:
+        import importlib
+
+        import clock as clock_mod
+
+        importlib.reload(clock_mod)
+        fixed = datetime(2026, 7, 27, 9, 28, 38)  # naive UTC, like clock._now()
+        out = clock_mod._fmt(fixed, "system")
+        expected = int(fixed.replace(tzinfo=__import__("datetime").timezone.utc).timestamp())
+        assert out["unix"] == expected
+    finally:
+        monkeypatch.delenv("TZ", raising=False)
+        if hasattr(_time, "tzset"):
+            _time.tzset()
+
+
+# ── B059 ─────────────────────────────────────────────────────────────────────
+def test_authorized_prose_is_not_a_caller():
+    import re
+
+    import liveness_lint
+
+    _module, patterns, _note = liveness_lint.SENTINEL_SEAMS["autonomous_mode.authorized"]
+    prose = "S-fixes authorized (earned, revocable)"
+    assert not any(re.search(pt, prose) for pt in patterns), \
+        "prose 'authorized (' must not count as a production caller of the seam"
+    # A genuine call site must still be recognised.
+    real = "if autonomous_mode.authorized(ctx):"
+    assert any(re.search(pt, real) for pt in patterns)
+
+
+# ── B062 ─────────────────────────────────────────────────────────────────────
+def test_redact_offsets_are_original_positions():
+    from redact import redact
+
+    key = "sk-" + "a" * 30                      # 33-char anthropic key
+    text = key + " AKIA1234567890123456"        # then a 20-char AWS key at offset 34
+    clean, hits = redact(text)
+    aws = [h for h in hits if h["pattern"] == "aws-access-key"]
+    assert aws, "AWS key not detected"
+    h = aws[0]
+    assert text[h["start"]:h["end"]] == "AKIA1234567890123456", \
+        f"offsets {h['start']}:{h['end']} do not index the AWS key in the ORIGINAL text"
+    assert h["start"] == 34
+    assert "[REDACTED:anthropic-openai]" in clean
+    assert "[REDACTED:aws-access-key]" in clean
+
+
+# ── B063 ─────────────────────────────────────────────────────────────────────
+def test_rule_id_prefix_not_falsely_alive(tmp_path):
+    import rules_loader as RL
+
+    ws = tmp_path
+    (ws / "safety").mkdir()
+    (ws / "safety" / "rules.md").write_text(
+        "## R-1 — low id\nstatus: active\n\n## R-10 — high id\nstatus: active\n",
+        encoding="utf-8",
+    )
+    (ws / "log").mkdir()
+    (ws / "log" / "_actions.log").write_text("action applied R-10\n", encoding="utf-8")
+
+    res = RL.audit(workspace=ws)
+    dead_ids = {d["id"] for d in res["dead"]}
+    assert "R-1" in dead_ids, "R-1 is never referenced and must be flagged dead"
+    assert "R-10" not in dead_ids, "R-10 is referenced and must stay alive"
