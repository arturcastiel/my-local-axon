@@ -43,7 +43,9 @@ def _fmt(now, source):
         "iso":       now.isoformat() + "Z",
         "date":      now.strftime("%Y-%m-%d"),
         "time":      now.strftime("%H:%M:%S"),
-        "unix":      int(now.timestamp()),
+        # `now` is a NAIVE UTC datetime; naive .timestamp() assumes LOCAL time, which
