diff --git a/tools/redact.py b/tools/redact.py
index cdcc1cf..4f7b26f 100644
--- a/tools/redact.py
+++ b/tools/redact.py
@@ -23,19 +23,35 @@ PATTERNS: list[tuple[str, re.Pattern]] = [
 
 def redact(text: str) -> tuple[str, list[dict]]:
     hits: list[dict] = []
-    out = text
-    # Apply each pattern; collect hits with original positions, then replace.
+    # Match every pattern against the ORIGINAL text so reported start/end are offsets
+    # into the input (the contract), not into the progressively-redacted string. A span
+    # already claimed by an earlier pattern is skipped, preserving the previous
+    # earlier-pattern-wins behaviour where later patterns ran on already-redacted text.
+    spans: list[tuple[int, int, str]] = []   # (start, end, replacement)
+    claimed: list[tuple[int, int]] = []
     for name, pat in PATTERNS:
-        def _sub(m):
+        for m in pat.finditer(text):
+            s, e = m.start(), m.end()
+            if any(s < ce and cs < e for cs, ce in claimed):
+                continue  # overlaps a region an earlier pattern already redacted
+            claimed.append((s, e))
             hits.append({
                 "pattern": name,
-                "start": m.start(),
-                "end": m.end(),
+                "start": s,
+                "end": e,
                 "sample": m.group(0)[:8],
             })
-            return f"[REDACTED:{name}]"
-        out = pat.sub(_sub, out)
-    return out, hits
+            spans.append((s, e, f"[REDACTED:{name}]"))
+    # Rebuild the redacted output from the original text using the collected spans.
+    spans.sort()
+    out_parts: list[str] = []
+    last = 0
+    for s, e, rep in spans:
+        out_parts.append(text[last:s])
+        out_parts.append(rep)
+        last = e
+    out_parts.append(text[last:])
+    return "".join(out_parts), hits
 
 
 def main():
