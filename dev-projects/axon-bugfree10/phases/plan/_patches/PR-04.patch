--- a/tools/doctrine_arming.py
+++ b/tools/doctrine_arming.py
@@ -56,8 +56,12 @@ def _run_has_receipts(workspace: str, run_id: str) -> bool:
         ws = Path(workspace) if workspace else None
         seen = False
         for row in loop_receipt._iter_ledger(ws):
+            # doctrine-fix H2 (axonbugfree10 B017): match the run-scoped rationale EXACTLY,
+            # not as a substring. `run {run_id}` is the WHOLE rationale doctrine_run emits,
+            # so an undelimited `in` let a forged run '1' borrow prefix-sibling run '10's
+            # committed receipt ('run 10' contains 'run 1') and pass the receipt gate.
             if (row.get("intent") == "doctrine-node"
-                    and f"run {run_id}" in str(row.get("rationale", ""))
+                    and str(row.get("rationale", "")).strip() == f"run {run_id}"
                     and row.get("phase") == "committed"):
                 seen = True
         return seen
diff --git a/tools/doctrine_preflight.py b/tools/doctrine_preflight.py
