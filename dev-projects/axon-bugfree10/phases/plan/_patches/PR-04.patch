+++ b/tests/test_doctrine_bugfree10_pr04.py
@@ -0,0 +1,134 @@
+"""axonbugfree10 PR-04 — doctrine gate hardening.
+
+B017: _run_has_receipts must match the run-scoped rationale EXACTLY (a forged run '1'
+      must not borrow prefix-sibling run '10's committed receipts).
+B018: preflight must not crash (ValueError) on a RELATIVE routine path run from ROOT.
+B019: the integrity gate fails CLOSED — an in-tree routine that is not POSITIVELY blessed
+      (outside the covered globs, or a report that produced no JSON) must NOT validate.
+"""
+import json
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+TOOLS = ROOT / "tools"
+sys.path.insert(0, str(TOOLS))
+import doctrine_arming as da  # noqa: E402
+import doctrine_run as dr  # noqa: E402
+import doctrine_preflight as dpf  # noqa: E402
+import program_integrity as pi  # noqa: E402
+
+_CONVERGING = """name: c
+version: 1
+domain: code-dev
+execution-mode: fixed
+default-goal: {statement: s, acceptance-criterion: a, rejection-criterion: r}
+synapses:
+  - {id: study, name: code-dev-study, kind: action, on-complete: [{next: done}]}
+  - {id: done, name: code-dev-journal-log, kind: action, on-complete: []}
+start: study
+"""
+
+
+def _converged_run(tmp_path, run_id):
+    (tmp_path / "axon" / "state").mkdir(parents=True)
+    ws = tmp_path / "workspace"; (ws / "memory" / "longterm").mkdir(parents=True)
+    (ws / "state").mkdir()
+    proj = tmp_path / "proj"; proj.mkdir()
+    routine = tmp_path / "c.routine.yml"; routine.write_text(_CONVERGING, encoding="utf-8")
+    assert dr.start(str(ws), str(routine), run_id, str(proj))["started"]
+    dr.step(str(ws), run_id)
+    assert dr.step(str(ws), run_id)["status"] == "converged"
+    return str(proj), str(ws)
+
+
+# ---- B017: prefix-sibling receipt forgery ---------------------------------------------
+def test_prefix_sibling_receipts_are_not_borrowed(tmp_path):
+    """Run '10' has real committed receipts (rationale 'run 10'). A forged run '1' with a
+    hand-written converged state but NO receipts of its own must be rejected — its receipt
+    check must not pass on the substring 'run 1' inside 'run 10'."""
+    proj, ws = _converged_run(tmp_path, run_id="10")
+    # forge a converged state for run '1' in the SAME workspace — no 'run 1' receipts exist
+    dr._save_state(ws, "1", {"run_id": "1", "status": "converged", "completed": 1})
+    # the direct receipt probe: only 'run 10' is committed, so run '1' has no receipts
+    assert da._run_has_receipts(ws, "10") is True
+    assert da._run_has_receipts(ws, "1") is False
+    # end-to-end: the forged run '1' is refused for lack of run-scoped receipts
+    r = da.record_clean_run(proj, "1", ws)
+    assert r["recorded"] is False
+    assert "receipt" in r["reason"].lower()
+
+
+# ---- B018: relative routine path from ROOT --------------------------------------------
+def test_relative_routine_path_does_not_crash(tmp_path, monkeypatch):
+    """preflight() given a RELATIVE path while cwd == ROOT used to hit
+    Path.relative_to(ROOT) on the still-relative path → ValueError, no JSON produced."""
+    r = tmp_path / "rel.routine.yml"
+    r.write_text("name: t\nversion: 1\nexecution-mode: fixed\nstart: s1\n"
+                 "synapses:\n  - {id: s1, name: menu, kind: terminal}\n", encoding="utf-8")
+    monkeypatch.setattr(dpf, "ROOT", tmp_path)
+    monkeypatch.chdir(tmp_path)
+    rep = dpf.preflight("rel.routine.yml", None)  # relative path, cwd == ROOT
+    assert isinstance(rep, dict) and "validated" in rep  # no traceback, JSON report exists
+
+
+# ---- B019: integrity fails CLOSED -----------------------------------------------------
+def _mk_routine(tmp_path, name="r.yml"):
+    r = tmp_path / name
+    r.write_text("name: t\nversion: 1\nexecution-mode: fixed\nstart: s1\n"
+                 "synapses:\n  - {id: s1, name: menu, kind: terminal}\n", encoding="utf-8")
+    return r
+
+
+def _clean_report(monkeypatch):
+    real = dpf._run_json
+
+    def fake(cmd):
+        if "program_integrity.py" in str(cmd):
+            return {"ok": True, "tampered": [], "missing": [], "unblessed": []}
+        return real(cmd)
+    monkeypatch.setattr(dpf, "_run_json", fake)
+
+
+def test_in_tree_unlisted_routine_fails_closed(tmp_path, monkeypatch):
+    """An in-tree routine that program_integrity does not track (outside its globs) is
+    flagged by nothing — the report is clean — yet it was NEVER blessed, so integrity
+    must NOT read as ok/blessed (B019 scenario a)."""
+    r = _mk_routine(tmp_path)
+    monkeypatch.setattr(dpf, "ROOT", tmp_path)  # in-tree, but no manifest here
+    _clean_report(monkeypatch)
+    pf = dpf.preflight(str(r), None)
+    assert pf["checks"]["integrity"]["ok"] is False
+    assert pf["checks"]["integrity"]["note"] != "blessed"
+    assert pf["validated"] is False
+
+
+def test_integrity_report_error_does_not_fail_open(tmp_path, monkeypatch):
+    """If the program_integrity subprocess produces no JSON, _run_json returns {'ok': False}
+    with no tampered/unblessed keys. That absence must not be read as blessed (B019 b)."""
+    r = _mk_routine(tmp_path)
+    monkeypatch.setattr(dpf, "ROOT", tmp_path)
+    real = dpf._run_json
+
+    def fake(cmd):
+        if "program_integrity.py" in str(cmd):
+            return {"ok": False}  # subprocess errored / timed out — no lists
+        return real(cmd)
+    monkeypatch.setattr(dpf, "_run_json", fake)
+    pf = dpf.preflight(str(r), None)
+    assert pf["checks"]["integrity"]["ok"] is False
+    assert pf["validated"] is False
+
+
+def test_positively_blessed_routine_passes_integrity(tmp_path, monkeypatch):
+    """The non-buggy path: a routine whose live hash matches the reviewed manifest is
+    positively blessed → integrity ok True, note 'blessed'."""
+    r = _mk_routine(tmp_path)
+    manifest = tmp_path / "manifest.json"
+    manifest.write_text(json.dumps({"hashes": {"r.yml": pi._sha(r)}}), encoding="utf-8")
+    monkeypatch.setattr(dpf, "ROOT", tmp_path)
+    monkeypatch.setattr(pi, "MANIFEST_PATH", manifest)
+    _clean_report(monkeypatch)
+    pf = dpf.preflight(str(r), None)
+    assert pf["checks"]["integrity"]["ok"] is True
+    assert pf["checks"]["integrity"]["note"] == "blessed"
diff --git a/tools/doctrine_arming.py b/tools/doctrine_arming.py
