--- a/tools/doctrine_preflight.py
+++ b/tools/doctrine_preflight.py
@@ -132,20 +132,35 @@ def preflight(routine_path: str, project_dir: str | None = None) -> dict:
 
     # 6. integrity: the routine file must be blessed (a poisoned routine can't validate)
     intg = _run_json([str(TOOLS / "program_integrity.py"), "report"])
-    routine_rel = str(p.relative_to(ROOT)) if str(ROOT) in str(p.resolve()) else routine_path
-    # Fail CLOSED (program_integrity M6): an UNBLESSED routine is an unreviewed
-    # instruction that could run — attackers ADD a poisoned routine, they don't edit a
-    # blessed one. The old check passed anything not in `tampered`, so an injected
-    # never-blessed routine could reach validated:True (axonbugfree3 wave B).
+    # B018: derive the in-tree rel-path from the RESOLVED path. `p` may be relative
+    # (e.g. `programs/foo.routine.yml` run from ROOT); `p.relative_to(ROOT)` on the still
+    # -relative p raises ValueError, aborting preflight with a traceback and no JSON report.
+    _in_tree = str(ROOT) in str(p.resolve())
+    routine_rel = str(p.resolve().relative_to(ROOT)) if _in_tree else routine_path
+    # Fail CLOSED (program_integrity M6 + axonbugfree10 B019): integrity passes ONLY when
+    # the routine is POSITIVELY confirmed blessed — present in the reviewed hash manifest
+    # with a matching live hash. "Not explicitly flagged" is NOT proof of blessing: a routine
+    # OUTSIDE program_integrity's covered globs, or a report subprocess that produced no JSON,
+    # leaves `tampered`/`unblessed` empty and the old check read that as blessed:True —
+    # exactly the injection class this gate claims to close. Out-of-tree fixtures stay
+    # runnable with an honest note (outside integrity scope).
     _tampered = routine_rel in intg.get("tampered", [])
     _unblessed = routine_rel in intg.get("unblessed", [])
-    _covered = not _tampered and not _unblessed and routine_rel not in intg.get("missing", [])
-    _in_tree = str(ROOT) in str(p.resolve())
-    checks["integrity"] = {"ok": (not _tampered) and (not _unblessed),
-                           "note": ("tampered — re-review + bless" if _tampered
-                                    else "unblessed (bless before binding)" if _unblessed
-                                    else "blessed" if _in_tree
-                                    else "out-of-tree (outside integrity scope)")}
+    _blessed = False
+    if _in_tree:
+        try:
+            import program_integrity
+            _manifest = program_integrity._load_manifest()
+            _blessed = (routine_rel in _manifest
+                        and not _tampered
+                        and _manifest[routine_rel] == program_integrity._sha(p.resolve()))
+        except Exception:
+            _blessed = False
+    checks["integrity"] = {"ok": _blessed if _in_tree else True,
+                           "note": ("out-of-tree (outside integrity scope)" if not _in_tree
+                                    else "tampered — re-review + bless" if _tampered
+                                    else "blessed" if _blessed
+                                    else "unblessed (bless before binding)")}
 
     validated = all(c.get("ok", False) for c in checks.values())
     return {"validated": validated, "routine": routine_path, "checks": checks,
