 # ─── R9 path-check — delegates to the canonical classifier (arch-audit #11 consolidation) ──
+def _axon_anchor(workspace_root: str) -> str:
+    """Repo root that actually holds the kernel `axon/` dir, relative to `workspace_root`.
+
+    B001 FIX: callers pass the tool's `workspace` (in production `<repo>/workspace`), but the
+    kernel dir is its SIBLING `<repo>/axon` — NOT `<repo>/workspace/axon`. Anchoring the R9
+    classifier to `workspace_root` therefore checked a non-existent dir, so ABSOLUTE (and
+    `../axon/…`) writes to the real kernel were classified as non-axon and slipped the gate.
+    Probe the parent first (production, axon/ is a sibling of workspace/); fall back to
+    `workspace_root` itself for self-contained topologies (tests/federation) where axon/ lives
+    INSIDE the workspace. Mirrors the `_resolve_repo_anchor` / `_doctrine_current_node` convention."""
+    parent = os.path.dirname(os.path.abspath(workspace_root))
+    if os.path.isdir(os.path.join(parent, "axon")):
+        return parent
+    return workspace_root
+
