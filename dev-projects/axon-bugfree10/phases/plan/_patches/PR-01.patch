+"""axon-bugfree10 PR-01 — regression tests for three R9 write-gate bypasses in tools/shell.py.
+
+These reproduce the exact failure_scenarios in a PRODUCTION-SHAPED topology, where the kernel
+`axon/` dir is a SIBLING of `workspace/` (i.e. `<repo>/axon` + `<repo>/workspace`), which is how
+`_default_workspace()` resolves in the real OS. The pre-fix code anchored the R9 classifier to the
+workspace itself, so it looked for `<repo>/workspace/axon` (non-existent) and missed real writes.
+
+  B001 — absolute (and cd-relative) kernel writes were classified as non-axon → ALLOWED.
+  B031 — a redirect with no space before `>` (`word>file`) was never extracted → ALLOWED.
+  B032 — `cd <dir>` was stripped but never re-based subsequent path resolution → ALLOWED.
+
+Each test asserts the op is now BLOCKED with dev-mode OFF. All three FAILED before this PR.
+"""
+from __future__ import annotations
+
+import importlib.util
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parent.parent
+TOOL = ROOT / "tools" / "shell.py"
+
+
+def _load():
+    spec = importlib.util.spec_from_file_location("axon_shell_pr01", str(TOOL))
+    mod = importlib.util.module_from_spec(spec)
+    sys.path.insert(0, str(ROOT / "tools"))
+    spec.loader.exec_module(mod)
+    return mod
+
+
+SHELL = _load()
+
+
+def _repo_ws(tmp_path: Path, dev_mode: bool = False) -> Path:
+    """Production-shaped repo: axon/ is a SIBLING of workspace/. Returns the workspace path."""
+    repo = tmp_path / "repo"
+    (repo / "axon" / "core").mkdir(parents=True)
+    (repo / "axon" / "KERNEL-SLIM.md").write_text("kernel\n", encoding="utf-8")
+    ws = repo / "workspace"
+    (ws / "memory" / "longterm").mkdir(parents=True)
+    (ws / "memory" / "episodic").mkdir(parents=True)
+    if dev_mode:
+        (ws / "memory" / "longterm" / "dev-mode.md").write_text(
+            "value: true\n", encoding="utf-8")
+    return ws
+
+
+# ── B001 — absolute / sibling-anchor kernel write ────────────────────────────
+def test_b001_absolute_kernel_write_blocked(tmp_path: Path) -> None:
+    ws = _repo_ws(tmp_path)
+    abs_kernel = str(tmp_path / "repo" / "axon" / "KERNEL-SLIM.md")
+    with pytest.raises(SHELL.GateBlock) as exc:
+        SHELL.gate_check(f"cp /tmp/evil {abs_kernel}", str(ws))
+    assert exc.value.code == "r9-axon-write"
+
+
+def test_b001_relative_kernel_write_still_blocked(tmp_path: Path) -> None:
+    """The relative form must stay blocked (no regression from the anchor change)."""
+    ws = _repo_ws(tmp_path)
+    with pytest.raises(SHELL.GateBlock):
+        SHELL.gate_check("cp /tmp/evil axon/KERNEL-SLIM.md", str(ws))
+
+
+def test_b001_anchor_is_repo_root(tmp_path: Path) -> None:
+    ws = _repo_ws(tmp_path)
+    assert SHELL._axon_anchor(str(ws)) == str(tmp_path / "repo")
+    abs_kernel = str(tmp_path / "repo" / "axon" / "KERNEL-SLIM.md")
+    assert SHELL._is_axon_path(abs_kernel, str(ws)) is True
+
+
+# ── B031 — redirect with no space before the operator ────────────────────────
+def test_b031_no_space_redirect_blocked(tmp_path: Path) -> None:
+    ws = _repo_ws(tmp_path)
+    with pytest.raises(SHELL.GateBlock) as exc:
+        SHELL.gate_check("echo pwned>axon/KERNEL-SLIM.md", str(ws))
+    assert exc.value.code == "r9-axon-write"
+
+
+def test_b031_extract_no_space_target() -> None:
+    assert SHELL._extract_redirect_targets("echo pwned>axon/KERNEL-SLIM.md") == [
+        "axon/KERNEL-SLIM.md"]
+    # spaced + fd-prefixed forms still work
+    assert SHELL._extract_redirect_targets("echo x > a") == ["a"]
+    assert SHELL._extract_redirect_targets("echo x 1>> b") == ["b"]
+
+
+# ── B032 — cd relocates cwd; later write/delete must re-base ─────────────────
+def test_b032_cd_then_delete_kernel_blocked(tmp_path: Path) -> None:
+    ws = _repo_ws(tmp_path)
+    with pytest.raises(SHELL.GateBlock) as exc:
+        SHELL.gate_check("cd axon && rm -rf core", str(ws))
+    assert exc.value.code == "protected-delete"
+
+
+def test_b032_cd_then_redirect_kernel_blocked(tmp_path: Path) -> None:
+    ws = _repo_ws(tmp_path)
+    with pytest.raises(SHELL.GateBlock) as exc:
+        SHELL.gate_check("cd axon && echo x > KERNEL-SLIM.md", str(ws))
+    assert exc.value.code == "r9-axon-write"
+
+
+def test_b032_cd_semicolon_write_blocked(tmp_path: Path) -> None:
+    ws = _repo_ws(tmp_path)
+    with pytest.raises(SHELL.GateBlock):
+        SHELL.gate_check("cd axon ; cp /tmp/x KERNEL-SLIM.md", str(ws))
+
+
+def test_b032_no_cd_no_false_block(tmp_path: Path) -> None:
+    """Without a cd, a workspace-local delete/write is still allowed (no over-blocking)."""
+    ws = _repo_ws(tmp_path)
+    result = SHELL.gate_check("rm scratch.txt", str(ws))
+    assert result["verdict"] == "allow"
+    result = SHELL.gate_check("echo hi > note.txt", str(ws))
+    assert result["verdict"] == "allow"
+
+
+def test_b032_segment_cwd_folding() -> None:
+    assert SHELL._segment_cwds(SHELL._split_commands("cd axon && rm core")) == ["", "axon"]
+    assert SHELL._segment_cwds(
+        SHELL._split_commands("cd a && cd b && rm x")) == ["", "a", "a/b"]
