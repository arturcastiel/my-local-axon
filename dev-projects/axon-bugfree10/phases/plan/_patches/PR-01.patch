+# ─── cwd (`cd`) modeling — B032 ──────────────────────────────────────────────
+def _leading_cd_dir(tokens: list[str]) -> str | None:
+    """If a segment's leading command (after env-assignments) is `cd <dir>`, return <dir>, else None."""
+    i = 0
+    while i < len(tokens):
+        t = tokens[i]
+        if "=" in t and re.match(r'^[A-Z_][A-Z0-9_]*=', t):
+            i += 1
+            continue
+        break
+    if i < len(tokens) and tokens[i] == "cd" and i + 1 < len(tokens) \
+            and not tokens[i + 1].startswith("-"):
+        return tokens[i + 1]
+    return None
+
+
+def _apply_cd(cur: str, d: str) -> str:
+    """Fold a `cd <d>` into the running relative-cwd prefix `cur` (relative to the repo root)."""
+    if os.path.isabs(d):
+        return os.path.normpath(d)
+    return os.path.normpath(os.path.join(cur or ".", d))
+
+
+def _join_cwd(prefix: str, target: str) -> str:
+    """Rebase a segment-local relative `target` onto the segment's cwd `prefix`."""
+    if not prefix or not target or os.path.isabs(target):
+        return target
+    return os.path.normpath(os.path.join(prefix, target))
+
+
+def _segment_cwds(commands: list[list[str]]) -> list[str]:
+    """The relative-cwd prefix in effect when each ordered segment runs. A leading `cd <dir>` in an
+    earlier `&&`/`;`/`|`-segment relocates the shell's cwd (subprocess runs the whole line under
+    shell=True), so a later `rm core` / `> KERNEL-SLIM.md` must be resolved against that dir — not
+    the workspace root. Without this, `cd axon && rm -rf core` was inspected as `core` (miss)."""
+    cwds: list[str] = []
+    cur = ""
+    for tokens in commands:
+        cwds.append(cur)
+        d = _leading_cd_dir(tokens)
+        if d is not None:
+            cur = _apply_cd(cur, d)
+    return cwds
 
 
