     `_axon_paths.is_axon_path` so this gate, the R9 rule, and the in-process io-gate cannot drift."""
     from _axon_paths import is_axon_path
-    return is_axon_path(p, anchor=workspace_root)
+    return is_axon_path(p, anchor=_axon_anchor(workspace_root))
+
