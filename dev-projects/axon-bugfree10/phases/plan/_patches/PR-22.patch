index 717271f..90d191f 100644
--- a/tests/test_dry_run.py
+++ b/tests/test_dry_run.py
@@ -62,3 +62,40 @@ def test_guard_must_precede_first_mutation(tmp_path):
     bad.write_text("MKDIR(x)\nIF RETRIEVE(W:code-dev-dry-run) ≡ true →\n", encoding="utf-8")
     v = dry_run_lint.check_program(bad)
     assert v and "AFTER" in v["hint"]
+
+
+def test_inline_arrow_mutator_is_caught(tmp_path):
+    """B009: a mutator whose only writes are inline after a conditional arrow
+    (`IF … → WRITE(…)`, `ELSE → MKDIR(…)`) has NO line-start op, so the old
+    `.match` anchored to `^\\s*` reported the program clean. With no dry-run guard
+    present it must now be flagged as unguarded."""
+    bad = tmp_path / "code-dev-inline.md"
+    bad.write_text('IF ready ≡ true → WRITE("out.txt", body)\n'
+                   'ELSE → MKDIR("out-dir")\n', encoding="utf-8")
+    v = dry_run_lint.check_program(bad)
+    assert v is not None, "inline-arrow mutator slipped the gate"
+    assert v["first_mutating_op"] == 1
+    assert "no W:code-dev-dry-run guard" in v["hint"]
+
+
+def test_guard_in_comment_does_not_satisfy_gate(tmp_path):
+    """B010: the only occurrence of the guard token is a descriptive comment; the real
+    `RETRIEVE(W:code-dev-dry-run)` runtime guard was deleted. The gate must NOT treat the
+    comment as a guard and must report the unguarded mutations."""
+    bad = tmp_path / "code-dev-commented.md"
+    bad.write_text("# C8 dry-run guard — code-dev whatif arms W:code-dev-dry-run\n"
+                   'MKDIR("dir")\n'
+                   'WRITE("f", "x")\n', encoding="utf-8")
+    v = dry_run_lint.check_program(bad)
+    assert v is not None, "comment-only guard token satisfied the gate"
+    assert "no W:code-dev-dry-run guard" in v["hint"]
+    assert v["first_mutating_op"] == 2
+
+
+def test_op_name_inside_string_is_not_a_mutation(tmp_path):
+    """A program that only mentions a mutating verb inside a string/comment (no real call)
+    must not be misread as an unguarded mutator (guards the .search widening)."""
+    ok = tmp_path / "code-dev-prose.md"
+    ok.write_text('LOG("this would WRITE(x) if armed")\n'
+                  '# note: MKDIR(dir) is deferred\n', encoding="utf-8")
+    assert dry_run_lint.check_program(ok) is None
diff --git a/tests/test_write_barrier.py b/tests/test_write_barrier.py
index a696f99..bd57f44 100644
--- a/tests/test_write_barrier.py
