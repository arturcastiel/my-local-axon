index b8f71d6..946accb 100644
--- a/tools/dry_run_lint.py
+++ b/tools/dry_run_lint.py
@@ -31,19 +31,54 @@ MUTATORS = (
     "code-dev-partition.md",
 )
 
+# A mutating library op is an executable call — it counts whether it opens the line
+# (after indent) OR is chained inline after a conditional arrow (`IF … → WRITE(…)`,
+# `ELSE → MKDIR(…)`). Anchoring to line-start only (the old `^\s*` + .match) let inline
+# mutators slip the gate entirely (B009). Matched with .search against a comment- and
+# string-stripped view (see _code_only) so op names living in prose/strings don't count.
 _MUTATING_OP = re.compile(
-    r"^\s*(?:WRITE|APPEND|MKDIR|COPY-FILE|COPY-RECURSIVE|COPY-DIR-CONTENTS|"
+    r"(?:^\s*|→\s*)(?:WRITE|APPEND|MKDIR|COPY-FILE|COPY-RECURSIVE|COPY-DIR-CONTENTS|"
     r"DELETE-DIR|REPLACE-LINE|REPLACE-SECTION|REPLACE-PATH|TRUNCATE|CONCAT-FILES)\(")
 _GUARD = re.compile(r"W:code-dev-dry-run")
 
 
+def _code_only(ln: str) -> str:
+    """Executable view of a line: drop the `#` comment tail and blank string interiors.
+    The dry-run guard token lives in a descriptive `# … W:code-dev-dry-run` comment on
+    every real mutator; matching the guard against the raw line let that comment satisfy
+    the gate even when the runtime `RETRIEVE(W:code-dev-dry-run)` guard was deleted (B010).
+    Blanking string bodies also stops an op name inside a literal from being read as a call."""
+    out = []
+    in_str = False
+    esc = False
+    for ch in ln:
+        if in_str:
+            if esc:
+                esc = False
+            elif ch == "\\":
+                esc = True
+            elif ch == '"':
+                in_str = False
+                out.append(ch)
+            continue                         # drop string-interior chars
+        if ch == '"':
+            in_str = True
+            out.append(ch)
+        elif ch == "#":
+            break                            # comment tail — not executable
+        else:
+            out.append(ch)
+    return "".join(out)
+
+
 def check_program(path: Path) -> dict | None:
     try:
-        lines = path.read_text(encoding="utf-8").splitlines()
+        raw = path.read_text(encoding="utf-8").splitlines()
     except OSError:
         return {"file": path.name, "error": "unreadable"}
+    lines = [_code_only(ln) for ln in raw]
     guard_at = next((i for i, ln in enumerate(lines, 1) if _GUARD.search(ln)), None)
-    first_mut = next((i for i, ln in enumerate(lines, 1) if _MUTATING_OP.match(ln)), None)
+    first_mut = next((i for i, ln in enumerate(lines, 1) if _MUTATING_OP.search(ln)), None)
     if first_mut is None:
         return None                       # no mutating ops — nothing to guard
     if guard_at is None:
