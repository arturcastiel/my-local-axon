+def test_barrier_refuses_os_open_write_of_kernel(tmp_path):
+    """B013: os.open() raises the `open` audit event with mode=None and the write intent
+    in the integer flags. The old mode-only check let `os.open(kernel, O_WRONLY|O_TRUNC)`
+    truncate the kernel floor. It must now be refused."""
+    (tmp_path / "axon").mkdir()
+    (tmp_path / "axon" / "KERNEL-SLIM.md").write_text("floor", encoding="utf-8")
+    rc, err = _run("import os; fd=os.open('axon/KERNEL-SLIM.md', os.O_WRONLY|os.O_TRUNC); "
+                   "os.write(fd, b'')", tmp_path)
+    assert rc != 0 and "write-barrier" in err
+    # and the kernel content survived (the truncate never landed)
+    assert (tmp_path / "axon" / "KERNEL-SLIM.md").read_text() == "floor"
+
+
+def test_barrier_allows_os_open_readonly_of_kernel(tmp_path):
+    """The flags path must still let a read-only os.open (flags == O_RDONLY, no write bit)
+    through — the agent reads protected files constantly."""
+    (tmp_path / "axon").mkdir()
+    (tmp_path / "axon" / "KERNEL-SLIM.md").write_text("floor", encoding="utf-8")
+    rc, err = _run("import os; fd=os.open('axon/KERNEL-SLIM.md', os.O_RDONLY); os.close(fd)",
+                   tmp_path)
+    assert rc == 0, err
+
+
 def test_barrier_allows_unprotected_write(tmp_path):
