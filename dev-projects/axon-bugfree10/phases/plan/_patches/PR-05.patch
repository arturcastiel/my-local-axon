-            cat = pr._menu_category(name, entry.get("area", ""))
-            if not cat:
+            area = entry.get("area", "")
+            # _menu_category never returns a falsy value, so `not cat` is dead:
+            # a genuine fall-through is one that reaches the catch-all default
+            # instead of a real name/area match.
+            if not _has_real_category(pr, name, area):
