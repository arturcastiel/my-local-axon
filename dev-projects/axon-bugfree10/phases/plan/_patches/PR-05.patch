diff --git a/tools/coherence_lint.py b/tools/coherence_lint.py
index 43058f9..a41acaa 100644
--- a/tools/coherence_lint.py
+++ b/tools/coherence_lint.py
@@ -22,6 +22,21 @@ def _program_names(progdir: Path) -> set:
     return {p.stem for p in progdir.glob("*.md") if not p.name.startswith("_")}
 
 
+def _has_real_category(pr, name: str, area: str) -> bool:
+    """True if the program matches a real menu category (name pattern or known area).
+
+    `programs_registry._menu_category` never returns a falsy value — an unmatched
+    program silently gets the catch-all default ``_AREA_CATEGORY.get(area, "System &
+    Config")``. So a program that matches *neither* a `_NAME_CATEGORY` key nor a
+    known `_AREA_CATEGORY` area has genuinely fallen through the taxonomy; this
+    reproduces `_menu_category`'s own matching to tell the two cases apart.
+    """
+    for key in pr._NAME_CATEGORY:
+        if name == key or name.startswith(key):
+            return True
+    return area in pr._AREA_CATEGORY
+
+
 def check(workspace: Path, axon: Path) -> dict:
     defects = []
     os_progs = _program_names(axon / "programs")
@@ -50,10 +65,15 @@ def check(workspace: Path, axon: Path) -> dict:
