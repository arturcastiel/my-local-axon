diff --git a/tools/harness_conformance.py b/tools/harness_conformance.py
index fbe5d2e..7582a23 100644
--- a/tools/harness_conformance.py
+++ b/tools/harness_conformance.py
@@ -19,16 +19,36 @@ HARNESS_DIR = ROOT / "workspace" / "harness"
 REQUIRED_CAPS = ("boot", "reanchor", "enforce", "log", "tools", "backstop")
 
 
+def _declares(text: str, key: str) -> bool:
+    """True if *text* has a real (non-comment) ``STORE(L:<key>...)`` declaration.
+
+    A bare substring match fails open: a capability named only inside a comment
+    (e.g. ``# TODO wire host-cap-enforce``) would satisfy the gate even though the
+    adapter never actually declares it. Only STORE lines that are not commented out
+    count as a real declaration.
+    """
+    needle = f"STORE(L:{key}"
+    for line in text.splitlines():
+        if line.lstrip().startswith("#"):
+            continue
+        if needle in line:
+            return True
+    return False
+
+
 def check(harness_dir: Path) -> dict:
     adapters = [p for p in sorted(harness_dir.glob("*.md")) if p.stem != "README"]
     violations = []
     for p in adapters:
         text = p.read_text(encoding="utf-8")
         issues = []
-        if "host-harness" not in text:
+        # generic.md is the documented "unknown host" fallback: it deliberately
+        # leaves L:host-harness unset so the identity gate renders the bare AXON
+        # identity. Every other adapter must really declare the harness.
+        if p.stem != "generic" and not _declares(text, "host-harness"):
             issues.append("missing L:host-harness")
         for cap in REQUIRED_CAPS:
-            if f"host-cap-{cap}" not in text:
+            if not _declares(text, f"host-cap-{cap}"):
                 issues.append(f"missing host-cap-{cap}")
         if issues:
             violations.append({"adapter": p.stem, "issues": issues})
