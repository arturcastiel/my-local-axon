-                                "detail": "no menu category"})
+                                "detail": f"falls through menu taxonomy "
+                                          f"(silently defaulted to {cat!r})"})
     except Exception as ex:  # a broken menu mapping is itself a coherence defect
         defects.append({"kind": "menu-check-error", "detail": str(ex)})
 
