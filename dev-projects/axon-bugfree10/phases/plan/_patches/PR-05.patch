+        f'{caps}\n')
+    r = hc.check(tmp_path)
+    assert r["ok"] is False
+    assert any("host-cap-enforce" in issue
+               for v in r["violations"] for issue in v["issues"])
+
+
+def test_comment_only_host_harness_is_flagged(tmp_path):
+    caps = "\n".join(f'STORE(L:host-cap-{c}, "self")' for c in hc.REQUIRED_CAPS)
+    (tmp_path / "bar.md").write_text(
+        '# this adapter mentions host-harness only in a comment\n' + caps + "\n")
+    r = hc.check(tmp_path)
+    assert r["ok"] is False
+    assert any("host-harness" in issue
+               for v in r["violations"] for issue in v["issues"])
+
+
+def test_generic_fallback_without_host_harness_passes(tmp_path):
+    """generic.md deliberately leaves host-harness unset — still conformant."""
+    caps = "\n".join(f'STORE(L:host-cap-{c}, "self")' for c in hc.REQUIRED_CAPS)
+    (tmp_path / "generic.md").write_text(
+        '# Fallback — leaves L:host-harness unset by design.\n' + caps + "\n")
+    assert hc.check(tmp_path)["ok"] is True
