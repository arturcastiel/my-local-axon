index 0000000..0334007
--- /dev/null
+++ b/tests/test_deps_table_routes.py
@@ -0,0 +1,68 @@
+"""Tests for tools/deps.py — B070: table-routed EXEC() dependencies.
+
+Router programs (e.g. interactive.md's COMMAND VOCABULARY) dispatch real EXEC()
+targets from markdown table cells. The scanner used to skip *every* table row,
+dropping those deps so `deps check` failed open on the highest-fanout routers.
+"""
+import sys
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent.parent / "tools"
+sys.path.insert(0, str(TOOLS))
+
+import deps  # noqa: E402
+
+
+_ROUTER = """# PROGRAM: router
+
+## INPUTS
+| Name | Type | Required |
+|------|------|----------|
+| flag | bool | no |
+
+## COMMAND VOCABULARY
+| User types | Action |
+|------------|--------|
+| `resume` | EXEC(resume) — resume a session |
+| `translate [f]` | EXEC(translate, {source: [f]}) — human-readable |
+| `add tool [n]` | EXEC(register-tool, {name: [n]}) |
+
+### Non-table dispatch
+EXEC(mode-suggest)
+"""
+
+
+def _write(tmp_path, name, text):
+    p = tmp_path / f"{name}.md"
+    p.write_text(text, encoding="utf-8")
+    return str(p)
+
+
+def test_extract_deps_captures_table_routed_execs(tmp_path):
+    fp = _write(tmp_path, "router", _ROUTER)
+    execs = deps.extract_deps(fp)["exec"]
+    # non-table dep still present
+    assert "mode-suggest" in execs
+    # table-routed deps must now be captured (previously dropped)
+    for target in ("resume", "translate", "register-tool"):
+        assert target in execs, f"{target} missing from {execs}"
+
+
+def test_extract_deps_ignores_plain_doc_table_rows(tmp_path):
+    """A table with no EXEC()/TOOL() call must not inject phantom deps."""
+    text = ("# PROGRAM: doc\n\n## INPUTS\n"
+            "| Name | Type |\n|------|------|\n| foo | bool |\n")
+    fp = _write(tmp_path, "doc", text)
+    d = deps.extract_deps(fp)
+    assert d["exec"] == [] and d["tools"] == []
+
+
+def test_check_flags_broken_table_route(tmp_path):
+    """A table-routed EXEC target that does not exist is now reported (not fail-open)."""
+    (tmp_path / "programs").mkdir()
+    (tmp_path / "programs" / "router.md").write_text(
+        "# PROGRAM: router\n\n| cmd | action |\n|-----|--------|\n"
+        "| `x` | EXEC(does-not-exist) |\n", encoding="utf-8")
+    graph = deps.build_graph(str(tmp_path), str(tmp_path / "no-axon"))
+    assert "does-not-exist" in graph["router"]["deps"]["exec"]
+    assert "does-not-exist" not in graph  # target program is genuinely missing
