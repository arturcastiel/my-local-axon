@@ -122,10 +125,13 @@ WHITELIST: frozenset = frozenset({
 # Detection
 # ---------------------------------------------------------------------------
 
-# Matches any quoted string that could be a mode arg to open().
-# We then filter by _is_write_mode to keep only 'w'/'a' modes and
-# exclude 'r', 'rb', 'r+', etc.
-_OPEN_RE = re.compile(r"""\bopen\s*\([^)]*?['"]([^'"]+)['"]""")
+# Match an open(...) call and capture its whole argument list up to the first
+# ')'.  We then inspect *every* quoted string inside those args and keep the call
+# only if one of them is a real write/append mode (via _is_write_mode).  Capturing
+# just the first quoted string (the old behaviour) missed raw writes where the
+# path is a literal and the mode is the 2nd string arg, e.g. open("out.json","w").
+_OPEN_CALL_RE = re.compile(r"""\bopen\s*\(([^)]*)""")
+_QUOTED_RE = re.compile(r"""['"]([^'"]+)['"]""")
 
 # Path.write_text(...) / Path.write_bytes(...)
 _WRITE_TEXT_RE = re.compile(r"""\.write_text\s*\(""")
@@ -168,8 +174,9 @@ def find_raw_writes(path: Path) -> list[dict]:
     for lineno, raw_line in enumerate(text.splitlines(), 1):
         line = _strip_line_comment(raw_line)
         matched = False
-        for m in _OPEN_RE.finditer(line):
-            if _is_write_mode(m.group(1)):
+        for m in _OPEN_CALL_RE.finditer(line):
+            args = m.group(1)
+            if any(_is_write_mode(q) for q in _QUOTED_RE.findall(args)):
                 findings.append({"lineno": lineno, "kind": "open-write",
                                   "snippet": raw_line.strip()[:80]})
