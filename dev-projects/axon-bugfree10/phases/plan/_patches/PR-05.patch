+# ---------------------------------------------------------------------------
+# B067 — literal-path open() where the mode is the 2nd string arg.  The old
+# regex captured only the first quoted string (the path) and, finding no valid
+# mode, silently passed — a raw write that bypassed atomic_write().
+# ---------------------------------------------------------------------------
+
+def test_detects_open_literal_path_write(tmp_path):
+    p = _write_py(tmp_path, "a.py", 'with open("out.json", "w") as f:\n    f.write("x")\n')
+    findings = ail.find_raw_writes(p)
+    assert len(findings) == 1
+    assert findings[0]["kind"] == "open-write"
+
+
+def test_detects_open_literal_path_append(tmp_path):
+    p = _write_py(tmp_path, "a.py", 'open("data/results.txt", "a").write(x)\n')
+    findings = ail.find_raw_writes(p)
+    assert len(findings) == 1
+    assert findings[0]["kind"] == "open-write"
+
+
+def test_detects_open_literal_path_write_nested_in_call(tmp_path):
+    p = _write_py(tmp_path, "a.py", 'json.dump(x, open("cache.json", "w"))\n')
+    findings = ail.find_raw_writes(p)
+    assert len(findings) == 1
+    assert findings[0]["kind"] == "open-write"
+
+
+def test_ignores_open_two_literal_read(tmp_path):
+    """Literal path + explicit read mode must still not be flagged."""
+    p = _write_py(tmp_path, "a.py", 'open("cache.json", "r").read()\n')
+    findings = ail.find_raw_writes(p)
+    assert findings == []
+
+
