index 0000000..00341a9
--- /dev/null
+++ b/tests/test_project_refresh_fix_report.py
@@ -0,0 +1,61 @@
+"""PR-14b / B090: cmd_reconcile must not discard the fix report on --fix.
+
+Failure scenario: `reconcile <proj> --fix` set res['fix_applied'] = apply_fix(...),
+then immediately rebound res to a fresh reconcile() dict (no 'fix_applied' key), so the
+printed JSON/text never told the caller whether/what was repointed even though the file
+was in fact mutated.
+"""
+from __future__ import annotations
+
+import io
+import json
+import os
+import sys
+from contextlib import redirect_stdout
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT / "tools"))
+
+import project_refresh as pr  # noqa: E402
+
+
+def _canon(tmp_path):
+    c = tmp_path / "canon"
+    (c / "tools" / "rules").mkdir(parents=True, exist_ok=True)
+    return c
+
+
+def _proj(tmp_path, meta_lines, name="proj"):
+    d = tmp_path / name
+    d.mkdir(exist_ok=True)
+    (d / "_meta.md").write_text("\n".join(meta_lines) + "\n", encoding="utf-8")
+    return str(d)
+
+
+def test_fix_applied_present_in_json_output(tmp_path):
+    c = _canon(tmp_path)
+    d = _proj(tmp_path, ["slug: x", "codebase:   /mnt/c/projects/axon"])
+
+    buf = io.StringIO()
+    with redirect_stdout(buf):
+        rc = pr.main(["reconcile", d, "--canonical", str(c), "--fix", "--json"])
+
+    out = json.loads(buf.getvalue())
+    assert "fix_applied" in out, "fix report was discarded by the post-fix re-read"
+    assert out["fix_applied"]["fixed"] is True
+    assert out["fix_applied"]["to"] == os.path.abspath(str(c))
+    # post-fix re-read still reflects the now-canonical, clean state
+    assert out["clean"] is True and rc == 0
+
+
+def test_fix_applied_absent_when_no_fix_requested(tmp_path):
+    c = _canon(tmp_path)
+    d = _proj(tmp_path, ["slug: x", "codebase:   /mnt/c/projects/axon"])
+
+    buf = io.StringIO()
+    with redirect_stdout(buf):
+        pr.main(["reconcile", d, "--canonical", str(c), "--json"])
+
+    out = json.loads(buf.getvalue())
+    assert "fix_applied" not in out
diff --git a/tests/test_reanchor_store_optlike_prompt.py b/tests/test_reanchor_store_optlike_prompt.py
