index 0000000..408c65a
--- /dev/null
+++ b/tests/test_reanchor_store_optlike_prompt.py
@@ -0,0 +1,105 @@
+"""PR-14b / B088: an option-like prompt must not be dropped by the reanchor hook.
+
+Failure scenario: a prompt that strips to a bare option token (e.g. "-h", "--foo")
+was passed as `--value <prompt>` / `--prompt <prompt>` / `--input <prompt>`. argparse
+in memory.py / prompt_log.py / anticipate.py then parses the token as an option and
+errors ("expected one argument"), so — because every call is capture_output and the
+result is ignored — that turn's prompt is silently lost. Fix: pass user text via the
+`--flag=value` form so it is never re-interpreted as an option.
+"""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+from types import ModuleType
+from unittest.mock import MagicMock
+
+import pytest
+
+ROOT = Path(__file__).resolve().parent.parent
+HOOKS = ROOT / "tools" / "hooks"
+
+
+def _load_reanchor() -> ModuleType:
+    spec = importlib.util.spec_from_file_location(
+        "reanchor_store_optlike", HOOKS / "reanchor_store.py")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def _capture_calls(monkeypatch, prompt):
+    mod = _load_reanchor()
+    calls = []
+
+    def fake_run(cmd, **kw):
+        calls.append(list(cmd))
+        m = MagicMock()
+        m.returncode = 0
+        m.stdout = '{"candidates": []}'
+        return m
+
+    monkeypatch.setattr("subprocess.run", fake_run)
+    monkeypatch.setattr(mod, "_read_stdin_json", lambda: {"prompt": prompt})
+    with pytest.raises(SystemExit) as exc:
+        mod.main()
+    assert exc.value.code == 0
+    return calls
+
+
+@pytest.mark.parametrize("prompt", ["-h", "--foo", "-v"])
+def test_option_like_prompt_not_passed_as_bare_arg(monkeypatch, prompt):
+    """The prompt must never sit as its own arg right after a value-taking flag —
+    that is exactly the form argparse rejects for an option-like token."""
+    calls = _capture_calls(monkeypatch, prompt)
+    prompt_flags = {"--value", "--prompt", "--input"}
+    for cmd in calls:
+        for i, tok in enumerate(cmd[:-1]):
+            if tok in prompt_flags:
+                assert cmd[i + 1] != prompt, (
+                    f"prompt {prompt!r} passed as bare arg after {tok} "
+                    f"(argparse will drop it): {cmd}")
+
+
+@pytest.mark.parametrize("prompt", ["-h", "--foo", "-v"])
+def test_option_like_prompt_carried_via_equals_form(monkeypatch, prompt):
+    """The prompt must be embedded via --flag=value so it survives argparse."""
+    calls = _capture_calls(monkeypatch, prompt)
+    joined = [" ".join(cmd) for cmd in calls]
+    # recent-user-input (memory), record (prompt_log), and anticipate --input
+    assert any(f"--value={prompt}" in j for j in joined), joined
+    assert any(f"--prompt={prompt}" in j for j in joined), joined
+    assert any(f"--input={prompt}" in j for j in joined), joined
+
+
+def test_option_like_prompt_round_trips_through_real_memory(monkeypatch, tmp_path):
+    """End-to-end: a '-h' prompt is actually stored (not silently lost)."""
+    import subprocess
+    import sys
+
+    mod = _load_reanchor()
+    monkeypatch.setattr(mod, "_read_stdin_json", lambda: {"prompt": "-h"})
+
+    real_run = subprocess.run
+
+    def scoped_run(cmd, **kw):
+        # Only actually execute the memory store; skip prompt_log/anticipate to keep
+        # the test hermetic and fast. Point memory at a temp workspace.
+        s = " ".join(str(x) for x in cmd)
+        if str(mod.MEMORY) in s and "recent-user-input" in s:
+            cmd = list(cmd) + ["--workspace", str(tmp_path)]
+            return real_run(cmd, **kw)
+        m = MagicMock()
+        m.returncode = 0
+        m.stdout = ""
+        return m
+
+    monkeypatch.setattr("subprocess.run", scoped_run)
+    with pytest.raises(SystemExit):
+        mod.main()
+
+    got = real_run(
+        [sys.executable, str(mod.MEMORY), "get", "--scope", "W",
+         "--key", "recent-user-input", "--workspace", str(tmp_path)],
+        capture_output=True, text=True)
+    assert '"value": "-h"' in got.stdout, got.stdout
