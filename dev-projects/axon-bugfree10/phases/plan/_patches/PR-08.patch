+def _rechain(rows: list[dict]) -> list[dict]:
+    """Recompute prev-sha for a rewritten row sequence (e.g. post-GC).
+
+    A GC that drops rows leaves each survivor's prev-sha pointing at a now-deleted
+    predecessor, which verify_chain would flag as a false tamper break. Walking the
+    surviving rows in order and re-linking each chained row to the hash of its new
+    predecessor restores an intact, verifiable chain rooted at 'genesis'. Legacy rows
+    (no prev-sha) stay legacy but still advance the running hash."""
+    def _row_hash(r):
+        return hashlib.sha256(
+            json.dumps({k: v for k, v in r.items() if k != "row-sha"},
+                       sort_keys=True, ensure_ascii=False).encode("utf-8")).hexdigest()
+
+    out: list[dict] = []
+    prev = "genesis"
+    for row in rows:
+        new_row = dict(row)
+        if "prev-sha" in new_row:
+            new_row["prev-sha"] = prev
+        prev = _row_hash(new_row)
+        out.append(new_row)
+    return out
+
+
 def verify_chain(workspace: Optional[Path] = None) -> dict:
     """Walk the ledger, recomputing each chained row's expected prev-sha from its
     predecessor. A break = a silent insertion/edit/deletion. MIGRATION-TOLERANT: rows
@@ -403,6 +432,10 @@ def cmd_gc(args: argparse.Namespace) -> int:
     # Rewrite ledger atomically via atomic_write (full replace, not append).
     if removed > 0:
         from _axon_io import atomic_write
+        # Re-chain the survivors: dropping rows orphans each successor's prev-sha,
+        # which verify_chain would misread as tampering. Re-linking restores an
+        # intact chain over the kept rows (PR-004 tamper-evidence preserved).
+        kept = _rechain(kept)
         payload = "".join(json.dumps(r, sort_keys=True, ensure_ascii=False) + "\n" for r in kept)
         atomic_write(path, payload, _actor=ACTOR_NAME)
     print(json.dumps({"removed": removed, "kept": len(kept)}))
