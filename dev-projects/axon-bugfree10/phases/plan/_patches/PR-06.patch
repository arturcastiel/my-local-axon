diff --git a/tests/test_quality_loop.py b/tests/test_quality_loop.py
index 5f36589..ac560a0 100644
--- a/tests/test_quality_loop.py
+++ b/tests/test_quality_loop.py
@@ -168,3 +168,61 @@ def test_unsigned_legacy_state_is_fail_closed(tmp_path):
                             "locked": False, "lock_reason": None}, indent=2), encoding="utf-8")
     st = _ramp(tmp_path, "ramp-status")
     assert st["integrity_ok"] is False and st["s_fix_authorized"] is False
+
+
+# ── B025: writers must NOT re-sign a present-but-unverified state ─────────────────
+def _write_unsigned_three_clean(tmp_path):
+    import json as _j
+    sp = tmp_path / "loops" / "quality.ramp.json"
+    sp.parent.mkdir(parents=True, exist_ok=True)
+    sp.write_text(_j.dumps({"cycles": [{"n": i + 1, "clean": True} for i in range(3)],
+                            "locked": False, "lock_reason": None}, indent=2), encoding="utf-8")
+    return sp
+
+
+def test_ramp_record_refuses_to_launder_unsigned_state(tmp_path):
+    """B025: ramp-record on a hand-written 3-clean state must refuse — not append a 4th
+    cycle and re-sign the whole array (which would forge autonomy)."""
+    _write_unsigned_three_clean(tmp_path)
+    assert _ramp(tmp_path, "ramp-status")["s_fix_authorized"] is False  # denied pre-record
+    rec = _ramp(tmp_path, "ramp-record", "--clean", "true", "--note", "x")
+    assert rec["ok"] is False                       # refused, not recorded
+    st = _ramp(tmp_path, "ramp-status")
+    assert st["integrity_ok"] is False              # still unsigned — not laundered clean
+    assert st["s_fix_authorized"] is False          # autonomy NOT granted
+    assert st["cycles_complete"] == 3               # no 4th cycle was appended
+
+
+def test_ramp_lock_resets_tampered_streak(tmp_path):
+    """B025: locking a tampered state must not re-sign its fraudulent clean streak
+    (which would survive a later human unlock). The streak is wiped."""
+    _write_unsigned_three_clean(tmp_path)
+    _ramp(tmp_path, "ramp-lock", "--reason", "S-fix broke a test")
+    st = _ramp(tmp_path, "ramp-status")
+    assert st["locked"] is True
+    assert st["cycles_complete"] == 0               # fraudulent streak wiped, not blessed
+    assert st["s_fix_authorized"] is False
+    # human unlock must not resurrect the wiped streak
+    _ramp(tmp_path, "ramp-unlock", "--human-confirm", "yes")
+    st2 = _ramp(tmp_path, "ramp-status")
+    assert st2["cycles_complete"] == 0 and st2["s_fix_authorized"] is False
+
+
+def test_ramp_unlock_does_not_bless_tampered_streak(tmp_path):
+    """B025: a human unlock of a tampered state must not re-sign its fraudulent streak."""
+    sp = _write_unsigned_three_clean(tmp_path)
+    import json as _j
+    state = _j.loads(sp.read_text()); state["locked"] = True
+    sp.write_text(_j.dumps(state, indent=2), encoding="utf-8")   # tampered + locked
+    _ramp(tmp_path, "ramp-unlock", "--human-confirm", "yes")
+    st = _ramp(tmp_path, "ramp-status")
+    assert st["cycles_complete"] == 0 and st["s_fix_authorized"] is False
+
+
+def test_ramp_record_still_earns_autonomy_legitimately(tmp_path):
+    """Guard the non-buggy path: signed records from a clean start still earn autonomy."""
+    for _ in range(3):
+        assert _ramp(tmp_path, "ramp-record", "--clean", "true")["ok"] is True
+    st = _ramp(tmp_path, "ramp-status")
+    assert st["integrity_ok"] is True and st["clean_streak"] == 3
+    assert st["s_fix_authorized"] is True
diff --git a/tests/test_test_runner_policy.py b/tests/test_test_runner_policy.py
index 731c03d..834e2bb 100644
--- a/tests/test_test_runner_policy.py
+++ b/tests/test_test_runner_policy.py
@@ -149,3 +149,57 @@ def test_agent_allowed_runs(monkeypatch, capsys):
     TR.cmd_run(_run_args())
     out = json.loads(capsys.readouterr().out)
     assert "refused" not in out and "verdict" in out
+
+
+# ── B033: verdict is fail-closed on collection/import errors + non-zero exit ──────
+def _run_with_report(monkeypatch, tmp_path, capsys, *, report, rc, stdout=""):
+    """Drive cmd_run (human actor) against a controlled pytest json-report + returncode."""
+    rp = Path("/tmp/axon-pytest-report.json")
+    rp.write_text(json.dumps(report))
+    monkeypatch.setattr(TR, "_actor", lambda a: "human")
+    monkeypatch.setattr(TR, "run_pytest",
+                        lambda *a, **k: SimpleNamespace(returncode=rc, stdout=stdout, stderr=""))
+    monkeypatch.setattr(TR, "LAST_RESULT_PATH", tmp_path / "last.json")
+    monkeypatch.setattr(TR.subprocess, "run",
+                        lambda *a, **k: SimpleNamespace(returncode=0, stdout="", stderr=""))
+    TR.cmd_run(_run_args())
+    return json.loads(capsys.readouterr().out)
+
+
+def test_verdict_fails_on_collection_error(monkeypatch, tmp_path, capsys):
+    """A suite whose module has an import/collection error: pytest exits non-zero and the
+    json summary carries {passed:N, failed:0, error:1}. The old `failed==0 -> PASS` rule
+    reported green (B033); the verdict must now be FAIL."""
+    report = {
+        "summary": {"passed": 2, "failed": 0, "error": 1, "total": 3},
+        "tests": [
+            {"outcome": "passed", "nodeid": "t::a"},
+            {"outcome": "passed", "nodeid": "t::b"},
+            {"outcome": "error", "nodeid": "t::c", "call": {"longrepr": "ImportError: boom"}},
+        ],
+        "duration": 0.1,
+    }
+    out = _run_with_report(monkeypatch, tmp_path, capsys, report=report, rc=2)
+    assert out["verdict"].startswith("FAIL")
+    assert out["errors"] == 1
+    assert out["returncode"] == 2
+    assert any("c" in f["test"] for f in out["failures"])
+
+
+def test_verdict_fails_on_nonzero_exit_with_no_reported_failures(monkeypatch, tmp_path, capsys):
+    """Missing json-report plugin / no tests collected: failed==0, error==0, but pytest
+    exits non-zero. Consulting only `failed` fails open; the returncode must veto PASS."""
+    report = {"summary": {"passed": 0, "failed": 0, "total": 0}, "tests": [], "duration": 0.0}
+    out = _run_with_report(monkeypatch, tmp_path, capsys, report=report, rc=4)
+    assert out["verdict"].startswith("FAIL")
+    assert out["returncode"] == 4
+
+
+def test_verdict_passes_on_genuinely_green_run(monkeypatch, tmp_path, capsys):
+    """Guard the non-buggy path: exit 0, no failures, no errors -> PASS."""
+    report = {"summary": {"passed": 3, "failed": 0, "error": 0, "total": 3},
+              "tests": [{"outcome": "passed", "nodeid": f"t::{i}"} for i in range(3)],
+              "duration": 0.2}
+    out = _run_with_report(monkeypatch, tmp_path, capsys, report=report, rc=0)
+    assert out["verdict"] == "PASS"
+    assert out["errors"] == 0 and out["returncode"] == 0
